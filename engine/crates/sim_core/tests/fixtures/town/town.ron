// Minimal, setting-free content pack used by the engine's own integration tests.
(
    meta: (id: "town", name: "Test town", version: "1"),
    bindings: (
        morale: "morale", perception: "perception", stealth: "stealth", speed: "speed",
        strength: "strength", intellect: "intellect", heroism: "heroism", press_reputation: "reputation",
        police_tag: "police", press_tag: "press", contraband_tag: "contraband", jail_zone_tag: "jail",
        currency_name: "coins",
    ),
    params: { "crime.witness_base": 0.95 },
    stats: [
        (id: "morale", name: "Morale", default: 50),
        (id: "perception", name: "Perception", default: 10),
        (id: "stealth", name: "Stealth", default: 0),
        (id: "speed", name: "Speed", min: 0, max: 5, default: 1),
        (id: "strength", name: "Strength", default: 10),
        (id: "intellect", name: "Intellect", default: 10),
        (id: "heroism", name: "Heroism", default: 0),
        (id: "reputation", name: "Reputation", min: -100, default: 0),
    ],
    needs: [
        (id: "hunger", name: "Hunger", per_tick: -1.0),
    ],
    body_plans: [
        (id: "humanoid", parts: [
            (id: "torso", name: "Torso", hp: 40, vital: true, coverage: 3),
            (id: "head", name: "Head", parent: "torso", hp: 20, vital: true, capacities: {"sight": 1}),
            (id: "arm_l", name: "Left arm", parent: "torso", hp: 20, capacities: {"manipulation": 1}),
            (id: "arm_r", name: "Right arm", parent: "torso", hp: 20, capacities: {"manipulation": 1}),
            (id: "leg_l", name: "Left leg", parent: "torso", hp: 20, capacities: {"moving": 1}),
            (id: "leg_r", name: "Right leg", parent: "torso", hp: 20, capacities: {"moving": 1}),
        ]),
    ],
    races: [
        (id: "human", name: "Human", body_plan: "humanoid", action_sets: ["daily_life"]),
        (id: "lizard", name: "Lizard", body_plan: "humanoid", action_sets: ["daily_life"], tags: ["cold_blooded"]),
    ],
    action_sets: [
        (id: "daily_life", name: "Daily life", actions: ["eat", "buy_food", "work", "idle"]),
    ],
    classes: [
        (id: "citizen", name: "Citizen", actions: []),
        (id: "thief", name: "Thief", actions: ["steal"], stats: {"stealth": 2}),
        (id: "cop", name: "Cop", actions: ["arrest_wanted", "patrol"], stats: {"speed": 1}),
        (id: "reporter", name: "Reporter", actions: ["publish", "roam"]),
    ],
    statuses: [
        (id: "tipsy", name: "Tipsy", tags: ["intossicazione"], intensity: 35, per_tick: -5.833, stats: {"perception": -2}, thresholds: [
            (name: "Al limite", above: 90, on_enter: [RemoveStatus("tipsy"), ApplyStatus(status: "wasted")]),
         ]),
        (id: "wasted", name: "Wasted", tags: ["intossicazione"], per_tick: -8.333, stats: {"perception": -6, "strength": 3}),
        (id: "flu", name: "Flu", tags: ["malattia"], intensity: 25, per_tick: 2.5, thresholds: [
            (name: "Sneezing", above: 25),
            (name: "Fever", above: 50, stats: {"strength": -5}),
         ], contagion: Some((radius: 1, per_tick: 100))),
    ],
    items: [
        (id: "bread", name: "Bread", category: "food", stack_max: 5, base_price: 5, tags: ["food"],
         on_use: [ModNeed(need: "hunger", amount: 0.6)]),
        (id: "beer", name: "Beer", category: "drink", stack_max: 5, base_price: 3, tags: ["drink"],
         on_use: [ApplyStatus(status: "tipsy")]),
        (id: "smuggled", name: "Smuggled goods", category: "loot", stack_max: 9, base_price: 20, tags: ["contraband"]),
    ],
    jobs: [
        (id: "eat", name: "Eat", handler: "consume", duration: 1, params: {"tag": "food"}),
        (id: "buy_food", name: "Buy food", work_type: "", handler: "buy", duration: 1, params: {"tag": "food"}),
        (id: "steal", name: "Steal", handler: "steal", duration: 2, params: {"amount": 30},
         crime: (id: "theft", severity: 12, witness_radius: 6, news: 0.6), suspicious: true),
        (id: "patrol", name: "Patrol", duration: 1),
        (id: "wander", name: "Wander", duration: 1),
        (id: "arrest", name: "Arrest", handler: "arrest", duration: 1, required_tags: ["police"]),
        (id: "publish", name: "Publish", handler: "publish", duration: 2, required_tags: ["press"]),
        (id: "move", name: "Move", duration: 0),
        (id: "haul", name: "Haul", work_type: "labor", duration: 3, effects: [ModMoney(2.0)]),
    ],
    actions: [
        (id: "eat", name: "Eat", weight: 1.0, kind: Job(job: "eat"),
         requires: HasItemTag("food"),
         considerations: [(input: Need("hunger"), curve: Inverse)]),
        (id: "buy_food", name: "Buy food", weight: 0.9, kind: Job(job: "buy_food", target: Nearest((sells_tag: "food"))),
         requires: All([Not(HasItemTag("food")), MoneyAtLeast(5)]),
         considerations: [(input: Need("hunger"), curve: Step(threshold: 0.5, below: true))]),
        (id: "work", name: "Work", weight: 0.5, kind: Work),
        (id: "idle", name: "Idle", weight: 0.05, kind: Idle),
        (id: "steal", name: "Steal", weight: 1.0, cooldown: 30,
         kind: Job(job: "steal", target: Nearest((pawn: true, min_money: 10, relation: Other, max_distance: 20))),
         considerations: [(input: Money(max: 100), curve: Inverse)]),
        (id: "arrest_wanted", name: "Arrest", weight: 2.0,
         kind: Job(job: "arrest", target: Nearest((pawn: true, min_wanted: "crime.arrest_threshold", not_detained: true, visible: true, max_distance: 12))),
         considerations: [(input: TargetExists)]),
        (id: "patrol", name: "Patrol", weight: 0.3, kind: Job(job: "patrol", target: Zone("#patrol"))),
        (id: "publish", name: "Publish", weight: 1.0, kind: Job(job: "publish"),
         considerations: [(input: Scoops(max: 1))]),
        (id: "roam", name: "Roam", weight: 0.2, kind: Job(job: "wander", target: Zone("square"))),
    ],
    factions: [
        (id: "town", name: "Town guild", playable: true, treasury: 500,
         ranks: [(id: "boss", name: "Boss", level: 5, unique: true, salary: 0), (id: "member", name: "Member", level: 1, salary: 5)]),
        (id: "police", name: "Police", role: Police, neutral: true, corruptibility: 1.0, treasury: 100,
         ranks: [(id: "officer", name: "Officer", level: 1, salary: 5)], zones: ["square"]),
        (id: "press", name: "Gazette", role: Press, neutral: true, treasury: 50,
         ranks: [(id: "reporter", name: "Reporter", level: 1, salary: 3)]),
    ],
    buildings: [
        (id: "shop", name: "Shop", hp: 100, tags: ["shop"], sells: {"bread": None, "beer": None}, markup: 1.0,
         stock: {"bread": 30, "beer": 10}),
        (id: "jail", name: "Jail", hp: 200, tags: ["jail"]),
        (id: "warehouse", name: "Warehouse", hp: 50,
         consequences: [(below: 0.5, name: "Deliveries late", effects: [GlobalModifier(id: "delays", name: "Delivery delays", duration: 24, logistics_disruption: 0.5)])]),
    ],
    map: (
        layers: [(id: "surface", name: "Surface", width: 40, height: 40)],
        zones: [
            (id: "square", name: "Square", layer: "surface", rect: (10, 10, 10, 10), tags: ["patrol", "public"]),
            (id: "jail", name: "Jail", layer: "surface", rect: (30, 30, 4, 4), tags: ["jail"]),
            (id: "outskirts", name: "Outskirts", layer: "surface", rect: (0, 0, 8, 8)),
        ],
    ),
    templates: [
        (id: "boss", name: "Boss", race: "human", classes: ["citizen"], faction: "town", rank: "boss", unique: true, money: 50),
        (id: "thief", name: "Thief", race: "human", classes: ["thief"], faction: "town", money: 0, items: {"smuggled": 2}),
        (id: "victim", name: "Rich citizen", race: "human", classes: ["citizen"], money: 80, stats: {"perception": 15}),
        (id: "cop", name: "Officer", race: "human", classes: ["cop"], faction: "police"),
        (id: "reporter", name: "Reporter", race: "human", classes: ["reporter"], faction: "press"),
        (id: "spy", name: "Spy", race: "lizard", classes: ["citizen"], faction: "town",
         disguise: (race: "human", faction: "police", name: "Officer Smith"), cover: 30),
    ],
    placements: [
        Player(id: "p1", name: "Player One", faction: "town"),
        Entity(template: "boss", zone: "square", at: (11, 11), leader_of: "p1"),
        Entity(template: "thief", zone: "square", at: (14, 14)),
        Entity(template: "victim", zone: "square", at: (15, 15)),
        Entity(template: "cop", zone: "square", at: (18, 18)),
        Entity(template: "reporter", zone: "square", at: (16, 12)),
        Building(building: "shop", zone: "square", at: (12, 18), owner_faction: "town"),
        Building(building: "jail", zone: "jail", at: (31, 31), owner_faction: "police"),
        Building(building: "warehouse", zone: "outskirts", at: (2, 2), owner_faction: "town"),
    ],
    press: (
        feed_name: "The Pigeon",
        headlines: { "arrest": ["{actor} arrests {target}!"], "crime": ["Theft in the square: {actor} strikes"] },
        default_headline: "{message}",
    ),
    news_impacts: [
        (topic: "arrest", market: [("food", 1.6, 1.0)], duration: 48, subject_reputation: -5),
        (topic: "crime", morale: -1),
    ],
    sprites: { "human": (shape: "circle", color: "#e0b080", glyph: "H") },
)
