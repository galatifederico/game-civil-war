            (id: "gamba_dx", name: "Gamba destra", parent: "busto", hp: 25, capacities: {"moving": 0.5}),
        ]),
        (id: "rettiliano", parts: [
            (id: "busto", name: "Busto squamoso", hp: 50, vital: true, coverage: 3),
            (id: "testa", name: "Testa", parent: "busto", hp: 25, vital: true, capacities: {"coscienza": 1, "vista": 1}),
            (id: "braccio_sx", name: "Braccio sinistro", parent: "busto", hp: 20, capacities: {"manipulation": 0.5}),
            (id: "braccio_dx", name: "Braccio destro", parent: "busto", hp: 20, capacities: {"manipulation": 0.5}),
            (id: "gamba_sx", name: "Gamba sinistra", parent: "busto", hp: 25, capacities: {"moving": 0.4}),
            (id: "gamba_dx", name: "Gamba destra", parent: "busto", hp: 25, capacities: {"moving": 0.4}),
            (id: "coda", name: "Coda", parent: "busto", hp: 15, capacities: {"moving": 0.2}),
        ]),
        (id: "quadrupede", parts: [
            (id: "corpo", name: "Corpo", hp: 50, vital: true, coverage: 4),
            (id: "testa", name: "Testa", parent: "corpo", hp: 20, vital: true, capacities: {"coscienza": 1, "vista": 1}),
            (id: "zampa_ant_sx", name: "Zampa anteriore sinistra", parent: "corpo", hp: 15, capacities: {"moving": 0.25}),
            (id: "zampa_ant_dx", name: "Zampa anteriore destra", parent: "corpo", hp: 15, capacities: {"moving": 0.25}),
            (id: "zampa_post_sx", name: "Zampa posteriore sinistra", parent: "corpo", hp: 15, capacities: {"moving": 0.25}),
            (id: "zampa_post_dx", name: "Zampa posteriore destra", parent: "corpo", hp: 15, capacities: {"moving": 0.25}),
            (id: "coda", name: "Codino", parent: "corpo", hp: 5, coverage: 0.3),
        ]),
        (id: "meccanico", parts: [
            (id: "telaio", name: "Telaio", hp: 60, vital: true, coverage: 4),
            (id: "cpu", name: "CPU", parent: "telaio", hp: 15, vital: true, capacities: {"coscienza": 1}),
            (id: "sensori", name: "Sensori", parent: "telaio", hp: 10, capacities: {"vista": 1}),
