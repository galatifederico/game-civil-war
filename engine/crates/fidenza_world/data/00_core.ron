// Fidenza & Salsomaggiore — basi: statistiche, bisogni, corpi, fluidi.
(
    meta: (
        id: "fidenza",
        name: "Fidenza e Salsomaggiore",
        version: "0.1.0",
        description: "Mondo satirico della Bassa: reliquie di San Donnino, Rettiliani al Fidenza Village, Boomer, Vegani e Ubriaconi.",
    ),
    bindings: (
        morale: "morale",
        perception: "percezione",
        stealth: "furtivita",
        speed: "velocita",
        strength: "forza",
        intellect: "intelletto",
        heroism: "eroismo",
        press_reputation: "reputazione_stampa",
        police_tag: "polizia",
        press_tag: "stampa",
        contraband_tag: "contrabbando",
        jail_zone_tag: "celle",
        ingestible_tags: ["cibo", "bevanda"],
        blood_fluid: "sangue",
        currency_name: "euro",
    ),
    params: {
        "crime.arrest_threshold": 10.0,
        "crime.search_threshold": 4.0,
        "crime.bribe_per_wanted": 12.0,
        "crime.witness_base": 0.8,
        "press.perception_range": 10.0,
        "anatomy.mutilation_heroism": 15.0,
        "anatomy.wound_heroism": 3.0,
        "market.change_event": 0.08,
        "social.hostile_threshold": -60.0,
        "logistics.batch": 8.0,
        "economy.guild_income_share": 0.5,
        "health.natural_heal": 0.15,
    },
    stats: [
        (id: "forza", name: "Forza", default: 10),
        (id: "destrezza", name: "Destrezza", default: 10),
        (id: "resistenza", name: "Resistenza", default: 10),
        (id: "percezione", name: "Percezione", default: 10),
        (id: "furtivita", name: "Furtività", default: 0),
        (id: "velocita", name: "Velocità", min: 0, max: 5, default: 1, description: "Passi per tick"),
        (id: "intelletto", name: "Intelletto", default: 10),
        (id: "carisma", name: "Carisma", default: 10),
        (id: "mistica", name: "Mistica", default: 0, description: "Potere delle arti mistiche (Vegani, Jedi, Sith, Maghi)"),
        (id: "morale", name: "Morale", default: 50, rest_value: 50, recovery: 0.5),
        (id: "umore", name: "Umore", default: 50, rest_value: 50, recovery: 0.3),
        (id: "eroismo", name: "Punti Eroismo", default: 0, max: 1000, description: "Guadagnati con ferite gravi e mutilazioni"),
        (id: "onore", name: "Punti Onore", default: 0, max: 1000),
        (id: "alcolismo", name: "Alcolismo", default: 0),
        (id: "vandalismo", name: "Vandalismo", default: 0),
        (id: "alpha_status", name: "Alpha Status", default: 10),
        (id: "baffi", name: "Baffi", default: 0, description: "Lunghezza e prestigio dei baffi"),
        (id: "alopecia", name: "Alopecia", default: 0),
        (id: "punti_gay", name: "Punti Gay", default: 0),
        (id: "punti_razzismo", name: "Punti Razzismo", default: 0),
        (id: "reputazione_stampa", name: "Reputazione Stampa", min: -100, default: 0),
    ],
    needs: [
        (id: "fame", name: "Fame", decay: 0.007, low_threshold: 0.1,
         effects_when_low: [ModStat(stat: "morale", amount: -0.6)]),
        (id: "riposo", name: "Riposo", decay: 0.02),
        (id: "svago", name: "Svago", decay: 0.008, low_threshold: 0.15,
         effects_when_low: [ModStat(stat: "umore", amount: -0.6), ModStat(stat: "morale", amount: -0.3)]),
    ],
    body_plans: [
        (id: "umanoide", parts: [
            (id: "busto", name: "Busto", hp: 40, vital: true, coverage: 3),
            (id: "testa", name: "Testa", parent: "busto", hp: 20, vital: true, capacities: {"coscienza": 1, "vista": 1}),
            (id: "baffi", name: "Baffi", parent: "testa", hp: 3, coverage: 0.2, tags: ["onore"]),
            (id: "braccio_sx", name: "Braccio sinistro", parent: "busto", hp: 20, capacities: {"manipulation": 0.5}),
            (id: "mano_sx", name: "Mano sinistra", parent: "braccio_sx", hp: 10, capacities: {"manipulation": 0.5}),
            (id: "braccio_dx", name: "Braccio destro", parent: "busto", hp: 20, capacities: {"manipulation": 0.5}),
            (id: "mano_dx", name: "Mano destra", parent: "braccio_dx", hp: 10, capacities: {"manipulation": 0.5}),
