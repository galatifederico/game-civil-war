            (id: "ruote", name: "Ruote/Rotori", parent: "telaio", hp: 20, capacities: {"moving": 1}),
        ]),
    ],
    fluids: [
        (id: "sangue", name: "Sangue", dirtiness: 1.0),
        (id: "vomito", name: "Vomito", dirtiness: 2.0),
        (id: "liquami", name: "Liquami", dirtiness: 3.0, carries: "diarrea"),
