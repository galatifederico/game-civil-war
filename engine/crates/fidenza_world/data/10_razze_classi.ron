// Razze, classi, abilità ed evoluzioni.
(
    races: [
        (id: "fidentino", name: "Fidentino", body_plan: "umanoide", action_sets: ["vita_quotidiana"], tags: ["umano", "aura_di_carne", "fidentino"],
         description: "Umano base di Fidenza. Storica rivalità con i Salsesi.", stat_ranges: {"baffi": (initial: 5)}),
        (id: "salsese", name: "Salsese", body_plan: "umanoide", action_sets: ["vita_quotidiana"], tags: ["umano", "aura_di_carne", "salsese"],
         description: "Umano base di Salsomaggiore, cresciuto a fanghi termali.", stat_ranges: {"resistenza": (initial: 12), "carisma": (initial: 12)}),
        (id: "nano", name: "Nano", body_plan: "umanoide", action_sets: ["vita_quotidiana"], actions: ["monta_in_sella"], tags: ["nano", "aura_di_carne", "scavatore"],
         description: "Specializzato nello scavo sotterraneo e nell'estrazione.", stat_ranges: {"forza": (initial: 15), "resistenza": (initial: 15), "velocita": (initial: 0.8), "baffi": (initial: 20)},
         abilities: ["evoca_dinosauro", "cavalca_dinosauro"]),
        (id: "elfo_logistica", name: "Elfo della Logistica", body_plan: "umanoide", action_sets: ["vita_quotidiana"], tags: ["elfo", "logistica"],
         description: "Maestro di imballaggio e consegne, velocissimo.", stat_ranges: {"velocita": (initial: 2), "destrezza": (initial: 15)}),
        (id: "rettiliano", name: "Rettiliano Mutaforma", body_plan: "rettiliano", action_sets: ["vita_quotidiana"], actions: ["mordi_umano"],
         tags: ["rettiliano", "sangue_freddo", "aura_di_carne"],
         description: "Assume sembianze umane, infetta, ruba identità e trasforma gli umani in maiali. Tutto il CdA del Fidenza Village.",
         stat_ranges: {"furtivita": (initial: 10), "carisma": (initial: 15), "intelletto": (initial: 15)},
         abilities: ["mutaforma", "morso_porcino"], immunities: ["mutazione_porcina"]),
        (id: "maiale", name: "Maiale", body_plan: "quadrupede", action_sets: ["istinti_animali"], tags: ["maiale", "animale", "aura_di_carne"],
         description: "Esito finale della Mutazione Porcina.", stat_ranges: {"intelletto": (initial: 5), "forza": (initial: 12)}),
        (id: "dinosauro", name: "Dinosauro", body_plan: "quadrupede", action_sets: ["istinti_animali"], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["dinosauro", "bestia", "cavalcatura"],
         description: "Evocato dai Nani: cavalcatura e guardiano delle gallerie.", stat_ranges: {"forza": (initial: 40), "resistenza": (initial: 30), "velocita": (initial: 1.5)}),
        (id: "robot", name: "Robot", body_plan: "meccanico", action_sets: ["routine_macchine"], sexes: [], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["robot", "macchina"],
         description: "Difende rotonde e infrastrutture per conto dell'Overmind.", stat_ranges: {"forza": (initial: 25), "percezione": (initial: 25)},
         immunities: ["diarrea", "std", "mutazione_porcina", "brillo", "fattone", "morbo_san_vitale"]),
        (id: "drone", name: "Drone", body_plan: "meccanico", action_sets: ["routine_macchine"], sexes: [], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["drone", "macchina"],
         description: "Occhio volante dell'Overmind.", stat_ranges: {"percezione": (initial: 35), "velocita": (initial: 2)},
         immunities: ["diarrea", "std", "mutazione_porcina", "brillo", "fattone", "morbo_san_vitale"]),
        (id: "zombie", name: "Zombie", body_plan: "umanoide", action_sets: ["istinti_non_morti"], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["zombie", "non_morto"],
         description: "Generato dal contagio di San Vitale.", stat_ranges: {"intelletto": (initial: 2), "velocita": (initial: 0.5), "resistenza": (initial: 20)},
         immunities: ["morbo_san_vitale", "diarrea", "std"]),
        (id: "droide", name: "Droide R2", body_plan: "meccanico", action_sets: ["routine_macchine"], sexes: [], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["droide", "macchina", "nerd"],
         description: "Bip bip. Supporto tecnico della Gilda Nerd.", immunities: ["diarrea", "std", "mutazione_porcina"]),
        (id: "androide", name: "Androide Waifu/Maid", body_plan: "umanoide", action_sets: ["vita_quotidiana"], tags: ["androide", "macchina", "nerd"],
         description: "Difesa e supporto morale della Gilda Nerd.", stat_ranges: {"carisma": (initial: 25), "destrezza": (initial: 20)},
         immunities: ["diarrea", "std", "mutazione_porcina"]),
        (id: "leone", name: "Leone", body_plan: "quadrupede", action_sets: ["istinti_animali"], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["leone", "bestia"],
         description: "Riscossione crediti del Casinò Diablo Tentator.", stat_ranges: {"forza": (initial: 35), "velocita": (initial: 1.5), "percezione": (initial: 20)}),
        (id: "talpa", name: "Talpa del Prosciutto", body_plan: "quadrupede", action_sets: ["istinti_animali"], tags: ["talpa", "bestia", "fauna"], needs_exempt: ["fame", "riposo", "svago", "sete"],
         description: "Talpa gigante delle miniere profonde: scava, annusa il prosciutto e morde.", stat_ranges: {"forza": (initial: 28), "percezione": (initial: 14)}),
        (id: "verme", name: "Verme del Lambrusco", body_plan: "quadrupede", action_sets: ["istinti_animali"], tags: ["verme", "bestia", "fauna"], needs_exempt: ["fame", "riposo", "svago", "sete"],
         description: "Enorme verme rosso frizzante delle caverne.", stat_ranges: {"forza": (initial: 32), "velocita": (initial: 0.7)}),
        (id: "ragno", name: "Ragno di Soia", body_plan: "quadrupede", action_sets: ["istinti_animali"], tags: ["ragno", "bestia", "fauna", "vegano"], needs_exempt: ["fame", "riposo", "svago", "sete"],
         description: "Tesse ragnatele di latte di soia nelle caverne.", stat_ranges: {"forza": (initial: 24), "velocita": (initial: 1.5), "furtivita": (initial: 15)}),
        (id: "cinghiale", name: "Cinghiale dello Stirone", body_plan: "quadrupede", action_sets: ["istinti_animali"], tags: ["cinghiale", "bestia", "fauna"], needs_exempt: ["fame", "riposo", "svago", "sete"],
         description: "Re del bosco dello Stirone: carica chi entra nel suo territorio.", stat_ranges: {"forza": (initial: 26), "velocita": (initial: 1.4)}),
        (id: "intelligenza_artificiale", name: "Intelligenza Artificiale", body_plan: "meccanico", action_sets: ["routine_macchine"], sexes: [], needs_exempt: ["fame", "riposo", "svago", "sete"], tags: ["virtuale", "macchina"],
         description: "Entità virtuale senza corpo fisico.", stat_ranges: {"intelletto": (initial: 100)}),
    ],
    abilities: [
        (id: "mutaforma", name: "Mutaforma", description: "Assume l'aspetto di un Fidentino qualunque.", cooldown: 48,
         requires: Not(Disguised), effects: [Shapeshift(race: "fidentino", name: "Un Fidentino qualunque")]),
        (id: "morso_porcino", name: "Morso Porcino", description: "Inocula la Mutazione Porcina.", cooldown: 24, range: 1, suspicious: true,
         effects: [On(Target, ApplyStatus(status: "mutazione_porcina"))]),
        (id: "evoca_dinosauro", name: "Evoca Dinosauro", description: "Richiama un dinosauro dalle profondità.", cooldown: 96,
         requires: InZone("#gallerie"), effects: [Spawn(template: "dinosauro", count: 1)]),
        (id: "cavalca_dinosauro", name: "Cavalca Dinosauro", description: "Il Nano monta in sella a un dinosauro della sua fazione.",
         cooldown: 48, requires: All([Not(HasStatus("in_sella")), Custom(id: "near", params: {"template": "dinosauro", "range": 2})]),
         effects: [ApplyStatus(status: "in_sella"), Custom(id: "mount", params: {"template": "dinosauro"})]),
        (id: "fumogeno", name: "Bomba Fumogena", description: "Invisibilità e reset dell'aggro.", cooldown: 24,
         requires: HasItem(item: "bomba_fumogena"),
         effects: [TakeItem(item: "bomba_fumogena"), Stealth(amount: 100, duration: 4), ResetAggro]),
        (id: "lama_avvelenata", name: "Lama Avvelenata", description: "Veleno da lama.", cooldown: 12, range: 1, suspicious: true,
         requires: HasItem(item: "katana"), effects: [On(Target, All([Damage(amount: 6), ApplyStatus(status: "avvelenato")]))]),
        (id: "levitazione", name: "Levitazione", description: "Il Vegano si solleva da terra.", cooldown: 24,
         effects: [ApplyStatus(status: "levitazione")]),
        (id: "telecinesi", name: "Telecinesi", description: "Scaglia oggetti con la mente.", cooldown: 12, range: 6,
         effects: [On(Target, Damage(amount: 8))]),
        (id: "smascheramento_aure", name: "Smascheramento delle Aure", description: "Rivela aure di carne e formaggio e le forme vere.", cooldown: 12,
         effects: [On(Radius(6), If(HasTag("aura_di_carne"), All([Expose, ModStat(stat: "morale", amount: -2)])))]),
        (id: "incantesimo_verginale", name: "Incantesimo Verginale", description: "Cura gli alleati vicini.", cooldown: 24,
         effects: [On(Radius(4), Heal(15))]),
        (id: "benedizione_yag", name: "Benedizione Yag", description: "Alza il morale di chi è vicino.", cooldown: 24,
         effects: [On(Radius(5), All([ModStat(stat: "morale", amount: 5), ModStat(stat: "punti_gay", amount: 1)]))]),
        (id: "spinta_della_forza", name: "Spinta della Forza", description: "Scaraventa via il nemico.", cooldown: 8, range: 5,
         effects: [On(Target, Damage(amount: 10))]),
        (id: "sguardo_tenebroso", name: "Sguardo Tenebroso", description: "Uno sguardo così cupo che passa la voglia di divertirsi (per un po').", cooldown: 12, range: 3,
         effects: [On(Target, ModStat(stat: "umore", amount: -8)), On(Target, ModNeed(need: "svago", amount: -0.15)), ModNeed(need: "svago", amount: 0.2)]),
        (id: "fulmine_sith", name: "Fulmine Sith", description: "Scarica elettrica del lato oscuro.", cooldown: 8, range: 5, suspicious: true,
         effects: [On(Target, All([Damage(amount: 14), ApplyStatus(status: "stordito")]))]),
    ],
)
