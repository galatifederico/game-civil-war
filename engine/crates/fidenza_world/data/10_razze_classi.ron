// Razze, classi, abilità ed evoluzioni.
(
    races: [
        (id: "fidentino", name: "Fidentino", body_plan: "umanoide", tags: ["umano", "aura_di_carne", "fidentino"],
         description: "Umano base di Fidenza. Storica rivalità con i Salsesi.", stats: {"baffi": 5}),
        (id: "salsese", name: "Salsese", body_plan: "umanoide", tags: ["umano", "aura_di_carne", "salsese"],
         description: "Umano base di Salsomaggiore, cresciuto a fanghi termali.", stats: {"resistenza": 2, "carisma": 2}),
        (id: "nano", name: "Nano", body_plan: "umanoide", tags: ["nano", "aura_di_carne", "scavatore"],
         description: "Specializzato nello scavo sotterraneo e nell'estrazione.", stats: {"forza": 5, "resistenza": 5, "velocita": -0.2, "baffi": 20},
         abilities: ["evoca_dinosauro"]),
        (id: "elfo_logistica", name: "Elfo della Logistica", body_plan: "umanoide", tags: ["elfo", "logistica"],
         description: "Maestro di imballaggio e consegne, velocissimo.", stats: {"velocita": 1, "destrezza": 5}),
        (id: "rettiliano", name: "Rettiliano Mutaforma", body_plan: "rettiliano", shapeshifter: true,
         tags: ["rettiliano", "sangue_freddo", "aura_di_carne"],
         description: "Assume sembianze umane, infetta, ruba identità e trasforma gli umani in maiali. Tutto il CdA del Fidenza Village.",
         stats: {"furtivita": 10, "carisma": 5, "intelletto": 5},
         abilities: ["mutaforma", "morso_porcino"], immunities: ["mutazione_porcina"]),
        (id: "maiale", name: "Maiale", body_plan: "quadrupede", tags: ["maiale", "animale", "aura_di_carne"],
         description: "Esito finale della Mutazione Porcina.", stats: {"intelletto": -5, "forza": 2}),
        (id: "dinosauro", name: "Dinosauro", body_plan: "quadrupede", tags: ["dinosauro", "bestia", "cavalcatura"],
         description: "Evocato dai Nani: cavalcatura e guardiano delle gallerie.", stats: {"forza": 30, "resistenza": 20, "velocita": 0.5}),
        (id: "robot", name: "Robot", body_plan: "meccanico", tags: ["robot", "macchina"],
         description: "Difende rotonde e infrastrutture per conto dell'Overmind.", stats: {"forza": 15, "percezione": 15},
         immunities: ["diarrea", "std", "mutazione_porcina", "brillo", "fattone", "morbo_san_vitale"]),
        (id: "drone", name: "Drone", body_plan: "meccanico", tags: ["drone", "macchina"],
         description: "Occhio volante dell'Overmind.", stats: {"percezione": 25, "velocita": 1},
         immunities: ["diarrea", "std", "mutazione_porcina", "brillo", "fattone", "morbo_san_vitale"]),
        (id: "zombie", name: "Zombie", body_plan: "umanoide", tags: ["zombie", "non_morto"],
         description: "Generato dal contagio di San Vitale.", stats: {"intelletto": -8, "velocita": -0.5, "resistenza": 10},
         immunities: ["morbo_san_vitale", "diarrea", "std"]),
        (id: "droide", name: "Droide R2", body_plan: "meccanico", tags: ["droide", "macchina", "nerd"],
         description: "Bip bip. Supporto tecnico della Gilda Nerd.", immunities: ["diarrea", "std", "mutazione_porcina"]),
        (id: "androide", name: "Androide Waifu/Maid", body_plan: "umanoide", tags: ["androide", "macchina", "nerd"],
         description: "Difesa e supporto morale della Gilda Nerd.", stats: {"carisma": 15, "destrezza": 10},
         immunities: ["diarrea", "std", "mutazione_porcina"]),
        (id: "leone", name: "Leone", body_plan: "quadrupede", tags: ["leone", "bestia"],
         description: "Riscossione crediti del Casinò Diablo Tentator.", stats: {"forza": 25, "velocita": 0.5, "percezione": 10}),
        (id: "intelligenza_artificiale", name: "Intelligenza Artificiale", body_plan: "meccanico", tags: ["virtuale", "macchina"],
         description: "Entità virtuale senza corpo fisico.", stats: {"intelletto": 90}),
    ],
    classes: [
        (id: "normie", name: "Normie", description: "Cittadino base.", work: {"trasporto": 3, "pulizia": 4, "produzione": 4, "agricoltura": 4}),
        (id: "cavaliere", name: "Cavaliere", description: "Combattimento in mischia.", stats: {"forza": 8, "onore": 10},
         actions: ["attacca_nemico"], work: {"combattimento": 1}),
        (id: "fabbro", name: "Fabbro", description: "Produce armi e armature.", stats: {"forza": 4}, work: {"forgia": 1, "produzione": 3}),
        (id: "muratore", name: "Muratore", description: "Costruzioni strutturali.", stats: {"forza": 3},
         actions: ["ripara_edificio"], work: {"costruzione": 1}),
        (id: "hacker", name: "Ingegnere Informatico / Hacker", description: "Violazione di sistemi e droni.", stats: {"intelletto": 10}, tags: ["hacker"],
         actions: ["hackera_macchina"], work: {"informatica": 1}),
        (id: "agricoltore", name: "Agricoltore", description: "Campi e idroponica.", actions: ["coltiva"], work: {"agricoltura": 1}),
        (id: "allevatore", name: "Allevatore", description: "Allevamento di suini e bestiame.", actions: ["alleva"], work: {"allevamento": 1, "macelleria": 2}),
        (id: "boomer", name: "Boomer", description: "Piazza Gnomi da Giardino spia e diffonde bufale.", stats: {"percezione": 3, "alpha_status": 5},
         actions: ["piazza_gnomo", "diffondi_bufala"], work: {"sorveglianza": 1}),
        (id: "mago_vergine", name: "Mago Vergine", description: "Arti mistiche della castità.", stats: {"mistica": 20},
         abilities: ["incantesimo_verginale"], actions: ["usa_incantesimo"]),
        (id: "yag", name: "Yag", description: "Mistico delle forze speciali.", stats: {"mistica": 15, "punti_gay": 10},
         abilities: ["benedizione_yag"], actions: ["usa_benedizione"]),
        (id: "jedi", name: "Jedi", description: "Usa la Forza (lato luminoso).", stats: {"mistica": 25, "destrezza": 5},
         abilities: ["spinta_della_forza"], actions: ["attacca_nemico", "usa_spinta"]),
        (id: "sith", name: "Sith", description: "Usa la Forza (lato oscuro).", stats: {"mistica": 25, "forza": 5},
         abilities: ["fulmine_sith"], actions: ["attacca_nemico", "usa_fulmine"]),
        (id: "medico", name: "Medico", description: "Esami clinici, cure, inoculazioni di massa.", stats: {"intelletto": 8},
         actions: ["esame_clinico", "cura_paziente", "inoculazione"], work: {"medicina": 1}),
        (id: "chimico", name: "Chimico", description: "Sintesi di farmaci, sieri e vaccini.", stats: {"intelletto": 10},
         actions: ["sintetizza_antidoto", "sintetizza_vaccino"], work: {"chimica": 1}),
        (id: "vegano", name: "Vegano (Mistico della Pianta)", description: "Levitazione, telecinesi.", stats: {"mistica": 20},
         abilities: ["levitazione", "telecinesi"], actions: ["levita", "usa_telecinesi"], work: {"agricoltura": 2}),
        (id: "polizia_vegana", name: "Polizia Vegana (Inquisitore della Soia)", description: "Smaschera aure di carne e formaggio.",
         stats: {"mistica": 25, "percezione": 10}, abilities: ["smascheramento_aure"], actions: ["smaschera_aure"]),
        (id: "spia", name: "Spia / Infiltrato", description: "Furto d'identità, infiltrazione, avvelenamento dei depositi.",
         stats: {"furtivita": 15, "carisma": 5}, actions: ["infiltrati", "ruba_identita", "avvelena_deposito"]),
        (id: "ninja", name: "Ninja", description: "Attacchi acrobatici, veleni, assalti silenziosi, fumogeni.",
         stats: {"furtivita": 20, "destrezza": 10, "velocita": 0.5}, abilities: ["fumogeno", "lama_avvelenata"],
         actions: ["assassina", "lancia_fumogeno", "usa_lama"]),
        (id: "poliziotto", name: "Poliziotto", description: "Pattuglia, perquisisce, sequestra, arresta.", stats: {"percezione": 5, "velocita": 0.5},
         actions: ["arresta_ricercato", "perquisisci_sospetto", "perquisizione_casuale", "pattuglia"]),
        (id: "giornalista", name: "Giornalista", description: "Inchieste sul campo e articoli sul Piccione Viaggiatore.", stats: {"percezione": 8},
         actions: ["pubblica_articolo", "indaga_sospetto", "caccia_scoop"]),
        (id: "logistico", name: "Addetto Logistica", description: "Imballaggio e consegne.", work: {"logistica": 1}),
        (id: "bestia", name: "Bestia", description: "Creatura guidata dall'istinto.", actions: ["sbrana_intruso", "vaga_nella_tana"]),
        (id: "guardiano", name: "Guardiano meccanico", description: "Difesa di rotonde e infrastrutture.", actions: ["difendi_zona", "pattuglia"]),
        (id: "riscossore", name: "Riscossore", description: "Recupera i crediti del Casinò con le buone o con le zanne.", actions: ["riscuoti_crediti"]),
        (id: "scavatore", name: "Minatore", description: "Estrazione nelle gallerie.", actions: ["scava"], work: {"estrazione": 1}),
    ],
    abilities: [
        (id: "mutaforma", name: "Mutaforma", description: "Assume l'aspetto di un Fidentino qualunque.", cooldown: 48,
         requires: Not(Disguised), effects: [Shapeshift(race: "fidentino", name: "Un Fidentino qualunque")]),
        (id: "morso_porcino", name: "Morso Porcino", description: "Inocula la Mutazione Porcina.", cooldown: 24, range: 1, suspicious: true,
         effects: [On(Target, ApplyStatus(status: "mutazione_porcina"))]),
        (id: "evoca_dinosauro", name: "Evoca Dinosauro", description: "Richiama un dinosauro dalle profondità.", cooldown: 96,
         requires: InZone("#gallerie"), effects: [Spawn(template: "dinosauro", count: 1)]),
        (id: "fumogeno", name: "Bomba Fumogena", description: "Invisibilità e reset dell'aggro.", cooldown: 24,
         requires: HasItem(item: "bomba_fumogena"),
         effects: [TakeItem(item: "bomba_fumogena"), Stealth(amount: 100, duration: 4), ResetAggro]),
        (id: "lama_avvelenata", name: "Lama Avvelenata", description: "Veleno da lama.", cooldown: 12, range: 1, suspicious: true,
         requires: HasItem(item: "katana"), effects: [On(Target, All([Damage(amount: 6), ApplyStatus(status: "avvelenato")]))]),
        (id: "levitazione", name: "Levitazione", description: "Il Vegano si solleva da terra.", cooldown: 24,
         effects: [ApplyStatus(status: "levitazione")]),
        (id: "telecinesi", name: "Telecinesi", description: "Scaglia oggetti con la mente.", cooldown: 12, range: 6,
         effects: [On(Target, Damage(amount: 8))]),
        (id: "smascheramento_aure", name: "Smascheramento delle Aure", description: "Rivela aure di carne e formaggio e le forme vere.", cooldown: 12,
         effects: [On(Radius(6), If(HasTag("aura_di_carne"), All([Expose, ModStat(stat: "morale", amount: -5)])))]),
        (id: "incantesimo_verginale", name: "Incantesimo Verginale", description: "Cura gli alleati vicini.", cooldown: 24,
         effects: [On(Radius(4), Heal(15))]),
        (id: "benedizione_yag", name: "Benedizione Yag", description: "Alza il morale di chi è vicino.", cooldown: 24,
         effects: [On(Radius(5), All([ModStat(stat: "morale", amount: 5), ModStat(stat: "punti_gay", amount: 1)]))]),
        (id: "spinta_della_forza", name: "Spinta della Forza", description: "Scaraventa via il nemico.", cooldown: 8, range: 5,
         effects: [On(Target, Damage(amount: 10))]),
        (id: "fulmine_sith", name: "Fulmine Sith", description: "Scarica elettrica del lato oscuro.", cooldown: 8, range: 5, suspicious: true,
         effects: [On(Target, All([Damage(amount: 14), ApplyStatus(status: "stordito")]))]),
    ],
)
