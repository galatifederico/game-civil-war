         actions: ["appicca_fuoco", "usa_molotov"]),
        (id: "spia", name: "Spia / Infiltrato", group: "Criminali", description: "Furto d'identità, infiltrazione (fare la talpa), avvelenamento dei depositi.",
         stats: {"furtivita": 15, "carisma": 5},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "furtivita", value: 14), StatAtLeast(stat: "eloquenza", value: 45), StatAtLeast(stat: "carisma", value: 12)])),
         actions: ["infiltrati", "ruba_identita", "avvelena_deposito", "pedina"], ),
        (id: "untore", name: "Untore", group: "Criminali", description: "Attacca malattie senza nemmeno toccarti.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatusTagCount(tag: "malattia", count: 2), StatAtLeast(stat: "puzza", value: 70), StatBelow(stat: "sanita_mentale", value: 45)])), loses_when: Some(Not(StatusTagCount(tag: "malattia", count: 2))),
         actions: ["usa_starnuto"]),
        (id: "riscossore", name: "Riscossore", group: "Criminali", description: "Recupera i crediti del Casinò con le buone o con le zanne.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "forza", value: 18), StatAtLeast(stat: "aggressivita", value: 60), MemberOf("casino_diablo")])), loses_when: Some(Not(MemberOf("casino_diablo"))),
         actions: ["riscuoti_crediti"]),

        // ── Ordine ──
        (id: "poliziotto", name: "Poliziotto", group: "Ordine", description: "Pattuglia, perquisisce, multa, arresta.", stats: {"percezione": 5, "velocita": 0.5, "difesa": 5},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "con_legge", value: 35), StatAtLeast(stat: "percezione", value: 14), StatBelow(stat: "reati", value: 1), MemberOf("polizia_neutra")])), loses_when: Some(Any([Not(MemberOf("polizia_neutra")), StatAtLeast(stat: "reati", value: 1)])),
         actions: ["arresta_ricercato", "perquisisci_sospetto", "perquisizione_casuale", "pattuglia", "multa"]),
        (id: "polizia_vegana", name: "Polizia Vegana (Inquisitore della Soia)", group: "Ordine", description: "Smaschera aure di carne e formaggio.",
