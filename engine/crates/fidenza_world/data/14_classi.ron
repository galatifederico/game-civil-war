         actions: ["gioca_azzardo", "usa_bara"]),
        (id: "hikikomori", name: "Hikikomori", group: "Vizi", description: "Speedrun e rage quit. Non esce di casa.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "c_ore_videogiochi", value: 400), StatBelow(stat: "carisma", value: 8), StatAtLeast(stat: "puzza", value: 70)])),
         actions: ["videogioca", "usa_speedrun", "rage_quit"]),
        (id: "barbone", name: "Barbone", group: "Vizi", description: "Sa tutti i pettegolezzi della strada.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), Not(MoneyAtLeast(10)), StatAtLeast(stat: "puzza", value: 80)])), loses_when: Some(MoneyAtLeast(100)),
         actions: ["elemosina", "usa_saggezza"], abilities: ["tanfo"]),
        (id: "casanova", name: "Casanova", group: "Vizi", description: "Fa girare la testa e spezza i cuori.", stats: {"carisma": 3},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), Any([StatAtLeast(stat: "bellezza", value: 60), StatAtLeast(stat: "carisma", value: 18)]), StatAtLeast(stat: "c_partner", value: 8),
                             StatAtLeast(stat: "capacita_sessuale", value: 60)])),
         actions: ["corteggia", "usa_spezza_cuori"]),

        // ── Criminali ──
        (id: "ladro", name: "Ladro", group: "Criminali", description: "Ruba meglio e scappa prima.", stats: {"furtivita": 5},
