         actions: ["guarda_cantieri", "usa_critica"]),
        (id: "boomer", name: "Boomer", group: "Ordine", description: "Piazza Gnomi da Giardino spia e diffonde bufale.", stats: {"percezione": 3, "alpha_status": 5},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "eta", value: 55), StatBelow(stat: "con_informatica", value: 20),
