// Classi (docs/azioni.md): ogni classe ha i requisiti per prenderla (`requires`). Una pedina che li soddisfa
// può diventarlo (il campione sceglie, le altre da sole); la perde quando scende sotto il 90% delle soglie.
// Scala delle statistiche del motore: Muscoli, Intelligenza, Percezione, Resistenza, Destrezza, Carisma hanno
// media 10 (20 = ottimo, 25+ = eccezionale); quasi tutto il resto va da 0 a 100.
(
    classes: [
        // ── Base ──
        (id: "normie", name: "Normie", group: "Base", description: "Cittadino base.",
         work: {"trasporto": 2, "pulizia": 4, "produzione": 4, "agricoltura": 4, "furto": 4, "estrazione": 3}),

        // ── Lavoro ──
        (id: "agricoltore", name: "Agricoltore", group: "Lavoro", description: "Campi e idroponica.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_agricoltura", value: 30), StatAtLeast(stat: "resistenza", value: 11)])),
         actions: ["coltiva", "coltiva_erba"], work: {"agricoltura": 1, "produzione": 2, "trasporto": 2}),
        (id: "allevatore", name: "Allevatore", group: "Lavoro", description: "Allevamento di suini e bestiame.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_agricoltura", value: 20), StatAtLeast(stat: "forza", value: 11), StatAtLeast(stat: "puzza", value: 20)])),
         actions: ["alleva"], work: {"allevamento": 1, "macelleria": 1, "trasporto": 3}),
        (id: "norcino", name: "Norcino", group: "Lavoro", description: "Culatello, salame e spalla cotta. La Polizia Vegana lo fiuta a un chilometro.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_norcineria", value: 40), StatAtLeast(stat: "forza", value: 12), StatAtLeast(stat: "c_maiali_macellati", value: 3)])),
         tags: ["aura_di_carne"], abilities: ["taglio_del_prosciutto"], actions: ["usa_taglio_prosciutto"], work: {"macelleria": 1, "produzione": 2}),
        (id: "muratore", name: "Muratore", group: "Lavoro", description: "Costruzioni strutturali.", stats: {"forza": 3},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_lavori_manuali", value: 30), StatAtLeast(stat: "forza", value: 12)])),
         actions: ["ripara_edificio"], work: {"costruzione": 1}),
        (id: "fabbro", name: "Fabbro", group: "Lavoro", description: "Produce armi e armature.", stats: {"forza": 4},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_lavori_manuali", value: 40), StatAtLeast(stat: "forza", value: 14), StatAtLeast(stat: "resistenza", value: 12)])),
         work: {"forgia": 1, "produzione": 3}),
        (id: "scavatore", name: "Minatore", group: "Lavoro", description: "Scava dove la fazione ha designato e porta i materiali al deposito.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), Any([IsRace("nano"), All([StatAtLeast(stat: "forza", value: 13), StatAtLeast(stat: "resistenza", value: 13)])])])),
         work: {"estrazione": 1, "trasporto": 2}),
        (id: "logistico", name: "Addetto Logistica", group: "Lavoro", description: "Imballaggio e consegne. Lo stress è un requisito.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "resistenza", value: 11), StatAtLeast(stat: "stress", value: 40)])),
         work: {"logistica": 1, "trasporto": 2}),
        (id: "chef", name: "Chef", group: "Lavoro", description: "Anolini che fanno passare lo stress, torta fritta che fa ingrassare.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_cucina", value: 50), StatAtLeast(stat: "grasso", value: 30), StatAtLeast(stat: "creativita", value: 40)])),
         abilities: ["banchetto"], actions: ["cucina_anolini", "cucina_torta_fritta", "usa_banchetto"], work: {"produzione": 1}),
        (id: "medico", name: "Medico", group: "Lavoro", description: "Esami clinici, cure, inoculazioni di massa.", stats: {"intelletto": 8},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_medicina", value: 50), StatAtLeast(stat: "intelletto", value: 18)])),
         actions: ["esame_clinico", "cura_paziente", "inoculazione", "medica_ferito"], work: {"medicina": 1}),
        (id: "chimico", name: "Chimico", group: "Lavoro", description: "Sintesi di farmaci, sieri e vaccini.", stats: {"intelletto": 10},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_medicina", value: 60), StatAtLeast(stat: "intelletto", value: 22)])),
         actions: ["sintetizza_antidoto", "sintetizza_vaccino"], work: {"chimica": 1}),
        (id: "hacker", name: "Ingegnere Informatico / Hacker", group: "Lavoro", description: "Violazione di sistemi, droni e del Piccione Viaggiatore.",
         stats: {"intelletto": 10}, tags: ["hacker"],
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_informatica", value: 60), StatAtLeast(stat: "intelletto", value: 18)])),
         actions: ["hackera_macchina", "hackera_piccione"], work: {"informatica": 1}),
        (id: "giornalista", name: "Giornalista", group: "Lavoro", description: "Inchieste sul campo e articoli sul Piccione Viaggiatore.", stats: {"percezione": 8},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_giornalismo", value: 35), StatAtLeast(stat: "percezione", value: 14), StatAtLeast(stat: "curiosita", value: 60)])),
         actions: ["pubblica_articolo", "indaga_sospetto", "caccia_scoop", "origlia"]),
        (id: "investigatore", name: "Investigatore", group: "Lavoro", stats: {"percezione": 6},
         description: "Va in giro a cercare informazioni precise: dov'è una reliquia, come si arriva dai Nani o in Cripta, chi è travestito, chi è ricercato, chi comanda. Quello che scopre lo scrive nel taccuino.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "con_investigazione", value: 40), StatAtLeast(stat: "percezione", value: 14), StatAtLeast(stat: "curiosita", value: 55)])),
         abilities: ["fiuto"],
         actions: ["indaga_reliquia", "indaga_strada_nani", "indaga_strada_cripta", "indaga_strada_cuore", "indaga_infiltrati", "indaga_ricercati", "indaga_ruoli",
                   "pedina", "origlia", "usa_fiuto"]),
        (id: "influencer", name: "Influencer", group: "Lavoro", description: "Vive di selfie e sponsorizzazioni.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "bellezza", value: 70), StatAtLeast(stat: "notorieta", value: 40), StatAtLeast(stat: "c_selfie", value: 30)])),
         abilities: ["sponsorizzata"], actions: ["selfie", "usa_sponsorizzata"]),
        (id: "tatuatore", name: "Tatuatore", group: "Lavoro", description: "Tatua chiunque, con l'ago del cugino.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano", "androide"]), StatAtLeast(stat: "creativita", value: 60), StatAtLeast(stat: "tatuaggi", value: 5)])),
         actions: ["tatua"]),

        // ── Fisiche ──
        (id: "ciccione", name: "Ciccione", group: "Fisiche", description: "Si siede sugli avversari e svuota i buffet.", stats: {"velocita": -0.2, "resistenza": 3, "difesa": 10},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "grasso", value: 80)])),
         abilities: ["schiacciata", "mangiata_colossale"], actions: ["usa_schiacciata", "usa_mangiata"]),
        (id: "palestrato", name: "Palestrato", group: "Fisiche", description: "Solleva persone e oggetti; la posa plastica fa girare la testa.", stats: {"forza": 3, "attacco": 8},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "forza", value: 22), StatBelow(stat: "grasso", value: 20), StatAtLeast(stat: "c_allenamenti", value: 50)])),
         abilities: ["sollevamento", "posa_plastica"], actions: ["allenati", "usa_sollevamento", "usa_posa_plastica"]),
        (id: "baffone", name: "Baffone", group: "Fisiche", description: "Uno sguardo da sotto i baffi e passa la voglia di litigare.", stats: {"carisma": 3},
