         abilities: ["visione_sciamanica"], actions: ["rolla_super_luca", "rolla_luca", "usa_visione_sciamanica"]),
        (id: "spacciatore", name: "Spacciatore", group: "Vizi", description: "Più soldi, meno rischi.", stats: {"furtivita": 4},
