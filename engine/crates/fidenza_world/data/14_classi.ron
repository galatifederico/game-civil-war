         abilities: ["sguardo_da_baffone"], actions: ["usa_sguardo_baffone"]),
        (id: "pelato", name: "Pelato", group: "Fisiche", description: "Al sole acceca chi gli sta davanti.", stats: {"alpha_status": 5},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "alopecia", value: 60), StatAtLeast(stat: "eta", value: 30)])),
         abilities: ["riflesso_accecante"], actions: ["usa_riflesso"]),
        (id: "rissaiolo", name: "Rissaiolo", group: "Fisiche", stats: {"attacco": 6}, description: "Testate e provocazioni.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "aggressivita", value: 70), StatAtLeast(stat: "forza", value: 14), StatAtLeast(stat: "c_risse_vinte", value: 10)])),
         abilities: ["testata"], actions: ["rissa", "usa_testata"]),
        (id: "cavaliere", name: "Cavaliere", group: "Fisiche", description: "Combattimento in mischia e duelli d'onore.", stats: {"forza": 8, "onore": 10, "attacco": 10, "difesa": 5},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "con_scherma", value: 50), StatAtLeast(stat: "onore", value: 30), StatAtLeast(stat: "forza", value: 14)])),
         actions: ["attacca_nemico", "sfida_a_duello"], work: {"combattimento": 1, "furto": 3}),
        (id: "spadaccino", name: "Spadaccino", group: "Fisiche", description: "Affondo a due caselle.", stats: {"destrezza": 4, "attacco": 8},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "con_scherma", value: 70), StatAtLeast(stat: "destrezza", value: 15), StatAtLeast(stat: "vista", value: 50)])),
         abilities: ["affondo"], actions: ["usa_affondo", "sfida_a_duello"], work: {"combattimento": 1}),
        (id: "monaco", name: "Monaco delle Arti Marziali", group: "Fisiche", description: "Pugno del Drago. Niente alcol, niente canne, niente stress.", stats: {"destrezza": 5, "attacco": 8, "difesa": 8},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "con_arti_marziali", value: 70), StatBelow(stat: "stress", value: 20), StatBelow(stat: "alcol", value: 1), StatBelow(stat: "thc", value: 1)])),
         abilities: ["pugno_del_drago"], actions: ["usa_pugno_drago", "pratica_arti_marziali"]),
        (id: "cecchino", name: "Cecchino", group: "Fisiche", description: "Colpisce da otto caselle.",
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "mira", value: 75), StatAtLeast(stat: "vista", value: 80), StatAtLeast(stat: "pazienza", value: 60)])),
         abilities: ["tiro_mirato"], actions: ["usa_tiro_mirato"]),
        (id: "ninja", name: "Ninja", group: "Fisiche", description: "Attacchi acrobatici, veleni, assalti silenziosi, fumogeni.",
         stats: {"furtivita": 20, "destrezza": 10, "velocita": 0.5, "attacco": 6},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "furtivita", value: 18), StatAtLeast(stat: "destrezza", value: 15), StatAtLeast(stat: "con_arti_marziali", value: 40)])),
         abilities: ["fumogeno", "lama_avvelenata"], actions: ["assassina", "lancia_fumogeno", "usa_lama"], work: {"furto": 1}),

        // ── Vizi ──
        (id: "ubriacone", name: "Ubriacone", group: "Vizi", description: "Regge l'alcol come nessuno; il suo rutto è un'arma.", stats: {"resistenza": 2},
         requires: Some(All([RaceIn(["fidentino", "salsese", "nano", "elfo_logistica", "rettiliano"]), StatAtLeast(stat: "tolleranza", value: 60), StatAtLeast(stat: "c_bevute", value: 100)])),
