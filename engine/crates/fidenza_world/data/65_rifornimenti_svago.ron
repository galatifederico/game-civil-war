// Conquista dei quartieri: stendardi. Rifornimenti da fuori (flusso stabile, la produzione locale ne copre una quota variabile), circostanze
// casuali che li alterano e luoghi di divertimento sparsi per la mappa.
(
    items: [
        (id: "gelato", name: "Gelato al Culatello", category: "cibo", stack_max: 5, base_price: 3, tags: ["cibo", "dolce"],
         on_use: [ModNeed(need: "fame", amount: 0.3), ModNeed(need: "svago", amount: 0.3)]),
    ],
    jobs: [
        (id: "pianta_stendardo", name: "Pianta lo stendardo", handler: "build", duration: 2, params: {"building": "stendardo"},
         effects: [ModMoney(-30.0)], news: 0.3),
        (id: "divertiti", name: "Si diverte", duration: 3,
         effects: [ModNeed(need: "svago", amount: 0.5), ModStat(stat: "morale", amount: 1.5), ModMoney(-1.0)]),
    ],
    actions: [
        // I capi delle fazioni (e il campione su ordine) piantano stendardi per conquistare i quartieri.
        (id: "pianta_stendardo", name: "Pianta lo stendardo", universal: true, weight: 0.04, cooldown: 72,
         kind: Job(job: "pianta_stendardo"),
         requires: All([MoneyAtLeast(60), HasTag("leader")])),
        (id: "divertiti", name: "Si diverte", universal: true, weight: 0.7, cooldown: 18,
         kind: Job(job: "divertiti", target: Nearest((building_tag: "svago", max_distance: 40))),
         requires: MoneyAtLeast(2),
         considerations: [(input: Need("svago"), curve: Logistic(steepness: -10, midpoint: 0.45))],
         label: "Si diverte"),
    ],
    buildings: [
        (id: "stendardo", name: "Stendardo", footprint: (1, 1), hp: 30, tags: ["stendardo"],
         description: "Il vessillo della fazione: chi ne pianta di più si prende il quartiere."),
        (id: "osteria", name: "Osteria", footprint: (3, 3), hp: 80, income: 20, tags: ["negozio", "svago", "bar"],
         sells: {"birra": None, "vino": None, "pane": None, "salumi": None}, markup: 1.2, stock: {"birra": 12, "vino": 8, "pane": 6, "salumi": 3},
         description: "Tagliere, Lambrusco e discussioni sul campionato fino a tardi."),
        (id: "bocciofila", name: "Bocciofila", footprint: (5, 3), hp: 60, income: 10, tags: ["svago", "boomer"],
         description: "Campo da bocce coperto: il quartier generale non ufficiale dei pensionati."),
        (id: "cinema", name: "Cinema", footprint: (5, 4), hp: 100, income: 30, tags: ["svago"],
         description: "Proietta solo film di Natale, anche ad agosto."),
        (id: "sala_slot", name: "Sala Slot", footprint: (3, 3), hp: 60, income: 40, tags: ["svago", "vizio"],
         description: "Luci al neon e la promessa di vincere il prosciutto d'oro."),
        (id: "parco_giochi", name: "Parco giochi", footprint: (3, 2), hp: 40, tags: ["svago", "pubblico"],
         description: "Altalene, scivolo e una panchina contesa tra mamme e piccioni."),
        (id: "campetto", name: "Campetto di calcetto", footprint: (5, 3), hp: 40, income: 8, tags: ["svago", "pubblico"],
         description: "Scapoli contro ammogliati, ogni giovedì da trent'anni."),
        (id: "balera", name: "Balera della Bassa", footprint: (5, 4), hp: 70, income: 25, tags: ["negozio", "svago", "bar"],
         sells: {"birra": None, "vino": None}, markup: 1.3, stock: {"birra": 15, "vino": 6},
         description: "Liscio, mazurka e polka fino all'alba."),
        (id: "gelateria", name: "Gelateria", footprint: (3, 2), hp: 50, income: 12, tags: ["negozio", "svago"],
         sells: {"gelato": None}, markup: 1.2, stock: {"gelato": 12},
         description: "Gusto del giorno: culatello e Lambrusco."),
    ],
    supplies: [
        (id: "pane", name: "Furgoni del pane", item: "pane", per_shop: 12, max_per_day: 60, variation: 0.25, cost: 0.3),
        (id: "ortaggi", name: "Ortofrutta dai grossisti", item: "ortaggi", per_shop: 8, max_per_day: 40, variation: 0.3, cost: 0.3),
        (id: "carne", name: "Camion frigo", item: "carne", per_shop: 5, max_per_day: 20, variation: 0.3, cost: 0.3),
        (id: "salumi", name: "Salumi da Langhirano", item: "salumi", per_shop: 4, max_per_day: 15, variation: 0.3, cost: 0.35),
        (id: "birra", name: "Flusso continuo di birra", item: "birra", per_shop: 15, max_per_day: 70, variation: 0.2, cost: 0.25),
        (id: "vino", name: "Lambrusco dalle cantine sociali", item: "vino", per_shop: 8, max_per_day: 30, variation: 0.25, cost: 0.3),
        (id: "grappa", name: "Grappa dal Veneto", item: "grappa", per_shop: 4, max_per_day: 10, variation: 0.3, cost: 0.35),
        (id: "estratto_soia", name: "Soia d'importazione", item: "estratto_soia", per_shop: 6, max_per_day: 20, variation: 0.3, cost: 0.3),
        (id: "fake_meat", name: "Fake meat industriale", item: "fake_meat", per_shop: 4, max_per_day: 15, variation: 0.3, cost: 0.35),
        (id: "gelato", name: "Gelato artigianale", item: "gelato", per_shop: 10, max_per_day: 20, variation: 0.3, cost: 0.3),
    ],
    global_modifiers: [
        (id: "sciopero_camionisti", name: "Sciopero dei camionisti sulla Via Emilia", morale: -3, supply: [("*", 0.3)]),
        (id: "nebbia_padana", name: "Nebbia in Val Padana: camion in ritardo", supply: [("*", 0.6)]),
        (id: "piena_stirone", name: "Piena dello Stirone: strade allagate", logistics_disruption: 0.3, morale: -2, supply: [("cibo", 0.5)]),
        (id: "festa_birra", name: "Festa della Birra di Fidenza", morale: 5, supply: [("birra", 2.5)]),
        (id: "sagra_culatello", name: "Sagra del Culatello", morale: 4, supply: [("salumi", 2.0), ("carne", 1.5)], price_tags: [("carne", 0.85)]),
        (id: "mercato_contadino", name: "Mercato contadino della domenica", morale: 2, supply: [("ortaggi", 2.0), ("pane", 1.5)]),
        (id: "lambrusco_ribaltato", name: "Camion di Lambrusco ribaltato in tangenziale", morale: 1, supply: [("vino", 0.2)]),
    ],
    triggers: [
        // Circostanze casuali: ogni giorno una piccola probabilità per ciascuna.
        (id: "c_sciopero", name: "Forse uno sciopero", repeat: true, cooldown: 24, when: TickAtLeast(48),
         effects: [Chance(0.03, GlobalModifier(id: "sciopero_camionisti", duration: 72))]),
        (id: "c_nebbia", name: "Forse nebbia", repeat: true, cooldown: 24, when: TickAtLeast(24),
         effects: [Chance(0.08, GlobalModifier(id: "nebbia_padana", duration: 24))]),
        (id: "c_piena", name: "Forse piena", repeat: true, cooldown: 24, when: TickAtLeast(72),
         effects: [Chance(0.03, GlobalModifier(id: "piena_stirone", duration: 48))]),
        (id: "c_festa_birra", name: "Forse festa della birra", repeat: true, cooldown: 24, when: TickAtLeast(24),
         effects: [Chance(0.05, GlobalModifier(id: "festa_birra", duration: 48))]),
        (id: "c_sagra", name: "Forse sagra", repeat: true, cooldown: 24, when: TickAtLeast(24),
         effects: [Chance(0.04, GlobalModifier(id: "sagra_culatello", duration: 48))]),
        (id: "c_mercato", name: "Forse mercato contadino", repeat: true, cooldown: 24, when: TickAtLeast(24),
         effects: [Chance(0.1, GlobalModifier(id: "mercato_contadino", duration: 24))]),
        (id: "c_lambrusco", name: "Forse camion ribaltato", repeat: true, cooldown: 24, when: TickAtLeast(24),
         effects: [Chance(0.03, GlobalModifier(id: "lambrusco_ribaltato", duration: 48))]),
    ],
)
