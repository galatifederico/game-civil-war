// Conquista dei quartieri: stendardi. Rifornimenti da fuori (flusso stabile, la produzione locale ne copre una quota variabile), circostanze
// casuali che li alterano e luoghi di divertimento sparsi per la mappa.
(
    items: [
        (id: "gelato", name: "Gelato al Culatello", category: "cibo", stack_max: 5, base_price: 3, tags: ["cibo", "dolce"],
         on_use: [ModStat(stat: "fame", amount: 30), ModStat(stat: "svago", amount: 30)]),
    ],
    actions: [
        // I capi delle fazioni (e il campione su ordine) piantano stendardi per conquistare i quartieri.
        (id: "pianta_stendardo", name: "Pianta lo stendardo", weight: 0.04, cooldown: 72,
         kind: Job(job: "pianta_stendardo"),
         requires: All([MoneyAtLeast(60), HasTag("leader")]), tags: ["territorio"],
         how: Some((handler: "build", duration: 2, params: {"building": "stendardo"}, effects: [ModMoney(-30.0)], news: 0.3))),
        (id: "divertiti", name: "Si diverte", weight: 0.7, cooldown: 18,
         kind: Job(job: "divertiti", target: Nearest((building_tag: "svago", max_distance: 40))),
         requires: MoneyAtLeast(2),
         considerations: [(input: Stat(stat: "svago", max: 100), curve: Logistic(steepness: -10, midpoint: 0.45))],
         label: "Si diverte", tags: ["svago"],
         how: Some((duration: 3, effects: [ModStat(stat: "svago", amount: 50), ModStat(stat: "morale", amount: 1.5), ModMoney(-1.0)]))),
    ],
    buildings: [
        (id: "stendardo", name: "Stendardo", footprint: (1, 1), hp: 30, tags: ["stendardo"],
         description: "Il vessillo della fazione: chi ne pianta di più si prende il quartiere."),
        (id: "osteria", name: "Osteria", footprint: (3, 3), hp: 80, tags: ["negozio", "svago", "bar"],
         sells: {"birra": None, "vino": None, "pane": None, "salumi": None}, markup: 1.2, stock: {"birra": 12, "vino": 8, "pane": 6, "salumi": 3},
         description: "Tagliere, Lambrusco e discussioni sul campionato fino a tardi.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 20)]),
        (id: "bocciofila", name: "Bocciofila", footprint: (5, 3), hp: 60, tags: ["svago", "boomer"],
         description: "Campo da bocce coperto: il quartier generale non ufficiale dei pensionati.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 10)]),
        (id: "cinema", name: "Cinema", footprint: (5, 4), hp: 100, tags: ["svago"],
         description: "Proietta solo film di Natale, anche ad agosto.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 30)]),
        (id: "sala_slot", name: "Sala Slot", footprint: (3, 3), hp: 60, tags: ["svago", "vizio"],
         description: "Luci al neon e la promessa di vincere il prosciutto d'oro.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 40)]),
        (id: "parco_giochi", name: "Parco giochi", footprint: (3, 2), hp: 40, tags: ["svago", "pubblico"],
         description: "Altalene, scivolo e una panchina contesa tra mamme e piccioni."),
        (id: "campetto", name: "Campetto di calcetto", footprint: (5, 3), hp: 40, tags: ["svago", "pubblico"],
         description: "Scapoli contro ammogliati, ogni giovedì da trent'anni.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 8)]),
        (id: "balera", name: "Balera della Bassa", footprint: (5, 4), hp: 70, tags: ["negozio", "svago", "bar"],
         sells: {"birra": None, "vino": None}, markup: 1.3, stock: {"birra": 15, "vino": 6},
         description: "Liscio, mazurka e polka fino all'alba.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 25)]),
        (id: "gelateria", name: "Gelateria", footprint: (3, 2), hp: 50, tags: ["negozio", "svago"],
         sells: {"gelato": None}, markup: 1.2, stock: {"gelato": 12},
         description: "Gusto del giorno: culatello e Lambrusco.",
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 12)]),
    ],
    supplies: [
        (id: "pane", name: "Furgoni del pane", item: "pane", per_shop: 12, max_per_day: 60, cost: 0.3),
        (id: "ortaggi", name: "Ortofrutta dai grossisti", item: "ortaggi", per_shop: 8, max_per_day: 40, cost: 0.3),
        (id: "carne", name: "Camion frigo", item: "carne", per_shop: 5, max_per_day: 20, cost: 0.3),
        (id: "salumi", name: "Salumi da Langhirano", item: "salumi", per_shop: 4, max_per_day: 15, cost: 0.35),
        (id: "bustine_santini", name: "Santini dalla tipografia diocesana", item: "bustina_santini", per_shop: 30, max_per_day: 30, cost: 0.3),
        (id: "bustine_pag", name: "Foto di Pag stampate a Salso", item: "bustina_foto_pag", per_shop: 15, max_per_day: 15, cost: 0.3),
        (id: "birra", name: "Flusso continuo di birra", item: "birra", per_shop: 15, max_per_day: 70, cost: 0.25),
        (id: "vino", name: "Lambrusco dalle cantine sociali", item: "vino", per_shop: 8, max_per_day: 30, cost: 0.3),
        (id: "grappa", name: "Grappa dal Veneto", item: "grappa", per_shop: 4, max_per_day: 10, cost: 0.35),
        (id: "estratto_soia", name: "Soia d'importazione", item: "estratto_soia", per_shop: 6, max_per_day: 20, cost: 0.3),
        (id: "fake_meat", name: "Fake meat industriale", item: "fake_meat", per_shop: 4, max_per_day: 15, cost: 0.35),
        (id: "gelato", name: "Gelato artigianale", item: "gelato", per_shop: 10, max_per_day: 20, cost: 0.3),
    ],
    global_modifiers: [
        (id: "sciopero_camionisti", name: "Sciopero dei camionisti sulla Via Emilia", per_tick: -1.389, stats: {"morale": -3}, supply: {"*": 0.3}),
        (id: "nebbia_padana", name: "Nebbia in Val Padana: camion in ritardo", per_tick: -4.167, supply: {"*": 0.6}),
        (id: "piena_stirone", name: "Piena dello Stirone: strade allagate", per_tick: -2.083, stats: {"morale": -2}, supply: {"cibo": 0.5}, logistics_disruption: 0.3),
        (id: "festa_birra", name: "Festa della Birra di Fidenza", per_tick: -2.083, stats: {"morale": 5}, supply: {"birra": 2.5}),
        (id: "sagra_culatello", name: "Sagra del Culatello", per_tick: -2.083, stats: {"morale": 4}, prices: {"carne": 0.85}, supply: {"salumi": 2.0, "carne": 1.5}),
        (id: "mercato_contadino", name: "Mercato contadino della domenica", per_tick: -4.167, stats: {"morale": 2}, supply: {"ortaggi": 2.0, "pane": 1.5}),
        (id: "lambrusco_ribaltato", name: "Camion di Lambrusco ribaltato in tangenziale", per_tick: -2.083, stats: {"morale": 1}, supply: {"vino": 0.2}),
        (id: "ordinanza", name: "Ordinanza del Sindaco", per_tick: -2.083, stats: {"morale": -1}),
    ],
    events: [
        (id: "c_sciopero", name: "Forse uno sciopero", when: TickAtLeast(48), every: 24, effects: [Chance(0.03, GlobalModifier(id: "sciopero_camionisti"))]),
        (id: "c_nebbia", name: "Forse nebbia", when: TickAtLeast(24), every: 24, effects: [Chance(0.08, GlobalModifier(id: "nebbia_padana"))]),
        (id: "c_piena", name: "Forse piena", when: TickAtLeast(72), every: 24, effects: [Chance(0.03, GlobalModifier(id: "piena_stirone"))]),
        (id: "c_festa_birra", name: "Forse festa della birra", when: TickAtLeast(24), every: 24, effects: [Chance(0.05, GlobalModifier(id: "festa_birra"))]),
        (id: "c_sagra", name: "Forse sagra", when: TickAtLeast(24), every: 24, effects: [Chance(0.04, GlobalModifier(id: "sagra_culatello"))]),
        (id: "c_mercato", name: "Forse mercato contadino", when: TickAtLeast(24), every: 24, effects: [Chance(0.1, GlobalModifier(id: "mercato_contadino"))]),
        (id: "c_lambrusco", name: "Forse camion ribaltato", when: TickAtLeast(24), every: 24, effects: [Chance(0.03, GlobalModifier(id: "lambrusco_ribaltato"))]),
    ],
)
