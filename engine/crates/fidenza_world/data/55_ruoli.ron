         kind: Job(job: "fai_fuori_il_boss", target: Nearest((pawn: true, condition: HoldsTitle("boss_dello_spaccio")))), considerations: [(input: TargetExists)]),
    ],
    titles: [
        // ── Ruoli delle fazioni ──
        (id: "diablo_tentator", name: "Diablo Tentator", faction: "casino_diablo", mode: Challenge, members_only: true, grace: 72,
         description: "Il padrone del Casinò. Si diventa Diablo battendo a carte quello in carica.",
         claim_requires: All([StatAtLeast(stat: "con_azzardo", value: 60), StatAtLeast(stat: "eloquenza", value: 50), MoneyAtLeast(1000), StatBelow(stat: "santita", value: 15)]),
         challenge_stat: "con_azzardo", stats: {"carisma": 5}, abilities: ["patto_col_diablo"], actions: ["usa_patto_diablo"], victory_points: 150, news: 0.9),
        (id: "capo_rivoluzionari", name: "Capo dei Rivoluzionari", faction: "anarchici_commercio", mode: Coup, members_only: true, grace: 72,
         description: "Chi guida gli Anarchici del Commercio. Si prende con un colpo di stato: contano i compagni intorno.",
         claim_requires: All([StatAtLeast(stat: "carisma", value: 18), StatAtLeast(stat: "eloquenza", value: 50), StatAtLeast(stat: "reati", value: 3)]),
         challenge_stat: "carisma", challenge_allies: 6, abilities: ["chiamata_alla_rivolta", "esproprio_proletario"], actions: ["usa_rivolta", "usa_esproprio"],
         victory_points: 150, news: 0.9),
        (id: "trono_degli_ubriaconi", name: "Re degli Ubriaconi", faction: "ubriaconi", seat_zone: "trono_ubriaconi",
         description: "Chi siede sul Trono comanda gli Ubriaconi. Si può anche battere il Re in una gara di bevute.",
         stats: {"carisma": 5, "tolleranza": 10}, abilities: ["giro_offerto"], actions: ["usa_giro"],
         victory_points: 400, grants_faction_control: true, news: 1.0),
        (id: "gran_maestro_templari", name: "Gran Maestro dei Templari", faction: "templari_borgo", mode: Challenge, members_only: true, grace: 120,
         description: "Si diventa Gran Maestro battendo quello in carica in duello.",
         claim_requires: All([StatAtLeast(stat: "con_scherma", value: 60), StatAtLeast(stat: "onore", value: 60), StatAtLeast(stat: "verginita", value: 1)]),
         challenge_stat: "con_scherma", stats: {"onore": 20}, abilities: ["crociata"], actions: ["usa_crociata"], victory_points: 150, news: 0.9),
        (id: "vescovo", name: "Il Vescovo", faction: "chiesa", mode: Appointment, members_only: true, grace: 168, vacancy_ticks: 48,
         description: "Nominato tra i più santi e dotti della Chiesa.",
         claim_requires: All([StatAtLeast(stat: "con_religione", value: 60), StatAtLeast(stat: "santita", value: 60), StatAtLeast(stat: "eta", value: 50),
                              StatAtLeast(stat: "iniziato_cristianesimo", value: 1)]),
         abilities: ["scomunica", "processione"], actions: ["usa_scomunica", "usa_processione"], victory_points: 150, news: 0.9),
        (id: "gran_custode", name: "Gran Custode di San Vitale", faction: "cripta_san_vitale", mode: Succession, members_only: true, grace: 168, vacancy_ticks: 24,
         description: "Sommo sacerdote del culto oscuro di San Vitale (cioè di Satana). Alla sua morte il più fanatico degli adepti prende il suo posto.",
         claim_requires: All([StatAtLeast(stat: "iniziato_sanatismo", value: 1), Any([StatAtLeast(stat: "fanatismo_san_vitale", value: 70), HasClass("profeta")]),
                              StatAtLeast(stat: "con_magia_nera", value: 30)]),
         score: {"fanatismo_san_vitale": 1.0, "con_magia_nera": 1.0, "mistica": 1.0},
