         kind: Job(job: "colpo_di_stato_anarchico", target: Nearest((pawn: true, condition: HoldsTitle("capo_rivoluzionari")))), considerations: [(input: TargetExists)]),
        (id: "sfida_gran_maestro", name: "Sfida il Gran Maestro", universal: true, weight: 0.3, cooldown: 240,
