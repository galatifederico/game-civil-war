        (id: "inaugura_cantiere", name: "Inaugura un cantiere", description: "Gli Umarell accorrono.", cooldown: 168,
         effects: [On(Radius(10), If(HasClass("umarell"), ModNeed(need: "svago", amount: 0.5))), ModStat(stat: "reputazione", amount: 3)]),
        (id: "profezia", name: "Profezia", description: "Rivela un segreto della mappa.", cooldown: 72, effects: [Custom(id: "oracle_reveal")]),
        (id: "comanda_la_fauna", name: "Comanda la fauna", description: "Le bestie delle profondità smettono di attaccare la sua fazione.", cooldown: 240,
         effects: [ModRelation(faction: "fauna_selvatica", amount: 60)]),
        (id: "prezzi_dell_erba", name: "Prezzi dell'erba", description: "Il Boss fissa il prezzo: incassa da tutti gli spacciatori.", cooldown: 72, effects: [ModMoney(60.0)]),
        (id: "sopralluogo", name: "Sopralluogo", description: "Un cantiere vicino va avanti più in fretta.", cooldown: 48, range: 6, effects: [On(Target, RepairBuilding(25.0))]),
