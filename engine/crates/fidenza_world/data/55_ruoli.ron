        // Sfide dell'AI ai titolari (chi ha i requisiti e nessun ruolo, ogni tanto ci prova).
        (id: "sfida_diablo", name: "Sfida il Diablo", universal: true, weight: 0.3, cooldown: 240,
         requires: All([Not(HoldsAnyTitle), MemberOf("casino_diablo"), StatAtLeast(stat: "con_azzardo", value: 60), StatAtLeast(stat: "eloquenza", value: 50), MoneyAtLeast(1000)]),
         kind: Job(job: "partita_col_diablo", target: Nearest((pawn: true, condition: HoldsTitle("diablo_tentator")))), considerations: [(input: TargetExists)]),
        (id: "colpo_di_stato_anarchico", name: "Colpo di stato", universal: true, weight: 0.3, cooldown: 240,
