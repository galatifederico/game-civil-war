    ],
    statuses: [
        (id: "in_crociata", name: "In crociata", kind: Buff, duration: 24, stats: {"forza": 4, "onore": 5, "aggressivita": 15}),
        (id: "scomunicato", name: "Scomunicato", kind: Debuff, duration: 240, tags: ["mistico"], stats: {"santita": -20, "morale": -5},
         description: "Fuori dalla Chiesa finché dura."),
        (id: "notte_di_san_vitale", name: "Notte di San Vitale", kind: Buff, duration: 12, stats: {"mistica": 10, "furtivita": 5, "malinconia": 10}),
        (id: "dieta_imposta", name: "Dieta imposta", kind: Debuff, duration: 48, stats: {"forza": -1}, need_rates: {"fame": 0.5}),
        (id: "in_rivolta", name: "In rivolta", kind: Buff, duration: 12, stats: {"aggressivita": 20, "fanatismo_leader": 15, "forza": 2}),
    ],
    abilities: [
        (id: "favore_massonico", name: "Favore massonico", description: "Un amico nelle Istituzioni cancella le accuse.", cooldown: 168, effects: [ClearWanted, ModMoney(-100.0)]),
        (id: "patto_col_diablo", name: "Patto col Diablo", description: "Soldi e fortuna a qualcuno, in cambio di un debito che i Riscossori verranno a riscuotere.",
         cooldown: 48, range: 3, effects: [On(Target, All([ModMoney(80.0), ModStat(stat: "fortuna", amount: 10), AddWanted(amount: 0.1, crime: "debito col Diablo")])), ModTreasury(40.0)]),
        (id: "chiamata_alla_rivolta", name: "Chiamata alla rivolta", description: "I compagni vicini si infiammano.", cooldown: 48,
         effects: [On(Radius(6), If(MemberOf("anarchici_commercio"), ApplyStatus(status: "in_rivolta")))]),
        (id: "esproprio_proletario", name: "Esproprio proletario", description: "Svuota un negozio e distribuisce la merce.", cooldown: 96, range: 2, suspicious: true,
         effects: [On(Target, DamageBuilding(20.0)), On(Radius(5), ModMoney(10.0)), AddWanted(amount: 6, crime: "esproprio")]),
        (id: "giro_offerto", name: "Giro offerto", description: "Da bere per tutti gli Ubriaconi vicini.", cooldown: 24,
         effects: [On(Radius(5), All([ModNeed(need: "svago", amount: 0.4), ModStat(stat: "stress", amount: -5), ModStat(stat: "alcol", amount: 10)])), ModMoney(-15.0)]),
        (id: "crociata", name: "Crociata", description: "Tutti i Templari partono all'attacco.", cooldown: 96,
         effects: [On(SubjectFaction, ApplyStatus(status: "in_crociata"))]),
        (id: "scomunica", name: "Scomunica", description: "Fuori dalla Chiesa.", cooldown: 72, range: 4, suspicious: false,
         effects: [On(Target, All([ApplyStatus(status: "scomunicato"), SetStat(stat: "iniziato_cristianesimo", value: 0)]))]),
        (id: "processione", name: "Processione", description: "Meno stress e più fede per tutti i fedeli intorno.", cooldown: 48,
         effects: [On(Radius(6), All([ModStat(stat: "stress", amount: -5), ModStat(stat: "fanatismo_chiesa", amount: 2)]))]),
        (id: "notte_oscura", name: "Notte di San Vitale", description: "Gli adepti della Cripta ricevono il potere oscuro.", cooldown: 72,
         effects: [On(SubjectFaction, All([ApplyStatus(status: "notte_di_san_vitale"), ModStat(stat: "fanatismo_san_vitale", amount: 2)]))]),
        (id: "dieta_per_tutti", name: "Dieta imposta", description: "Tutti i membri: meno grasso, più mana.", cooldown: 96,
         effects: [On(SubjectFaction, All([ApplyStatus(status: "dieta_imposta"), ModStat(stat: "grasso", amount: -3), ModStat(stat: "mistica", amount: 1)]))]),
        (id: "birra_per_tutti", name: "Birra per tutti", description: "Una birra a ogni nano.", cooldown: 48, effects: [On(SubjectFaction, GiveItem(item: "birra"))]),
        (id: "saldi", name: "Saldi", description: "Prezzi giù, clienti su.", cooldown: 168, effects: [MarketShock(tag: "lusso", demand: 1.6, supply: 1.4, duration: 48), ModTreasury(200.0)]),
        (id: "taglia", name: "Taglia", description: "Mette una taglia su qualcuno: diventa ricercato.", cooldown: 48, range: 6, effects: [On(Target, AddWanted(amount: 6, crime: "taglia"))]),
        (id: "smentita", name: "Smentita", description: "La redazione smentisce le bufale.", cooldown: 72,
         effects: [Publish(headline: "La Redazione smentisce: le notizie sui Rettiliani del Vescovo sono false", truth: Real, topics: ["smentita"])]),
        (id: "consegna_regali", name: "Consegna regali", description: "Regali a chi è vicino.", cooldown: 72, effects: [On(Radius(5), GiveItem(item: "regalo_di_natale"))]),
        (id: "lista_dei_cattivi", name: "Lista dei cattivi", description: "Carbone e sfortuna.", cooldown: 48, range: 5, effects: [On(Target, ModStat(stat: "fortuna", amount: -10))]),
        (id: "catena_sant_antonio", name: "Catena di Sant'Antonio", description: "Una bufala arriva a tutti.", cooldown: 72,
         effects: [Publish(headline: "INOLTRA A 10 AMICI: i Vegani mettono la soia nell'acquedotto!", truth: Fake, topics: ["bufala", "vegano"]), ModStat(stat: "c_bufale", amount: 1)]),
        (id: "grazia", name: "Grazia", description: "Cancella le accuse di qualcuno.", cooldown: 168, range: 3, effects: [On(Target, ClearWanted)]),
        (id: "ordinanza", name: "Ordinanza", description: "Divieto di alcol in piazza: meno risse, più stress.", cooldown: 168,
