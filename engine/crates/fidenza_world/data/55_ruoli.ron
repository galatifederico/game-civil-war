// Ruoli (docs/azioni.md, sezione Ruoli): posti unici nel mondo o in una fazione, con requisiti, un modo per
// ottenerli (trono, successione, elezione, nomina, sfida, colpo di stato, acquisto) e dei poteri.
// I ruoli si sommano alla classe. Chi resta sotto i requisiti per `grace` tick perde il ruolo.
(
    factions: [
        (id: "massoni", name: "Loggia Massonica del Borgo", treasury: 3000,
         description: "Grembiulini, compassi e favori. Nessuno sa chi ne fa parte.",
         ideology: {"capitale": 0.8, "tradizione": 0.5}, relations: {"chiesa": -20, "istituzioni": 40, "cda_fidenza_village": 30},
         ranks: [(id: "gran_maestro_loggia", name: "Gran Maestro Venerabile", level: 5, unique: true, salary: 50), (id: "fratello", name: "Fratello", level: 2, salary: 20)]),
    ],
    classes: [
        (id: "massone", name: "Massone", group: "Ordine", priority: 3, description: "Fa e riceve favori: un'Istituzione chiude un occhio sui suoi reati.",
         requires: Some(All([MemberOf("massoni"), MoneyAtLeast(1000), StatAtLeast(stat: "carisma", value: 15), StatAtLeast(stat: "reputazione", value: 30)])),
         abilities: ["favore_massonico"], actions: ["usa_favore"]),
    ],
    templates: [
