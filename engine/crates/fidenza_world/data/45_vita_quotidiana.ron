        (id: "battesimo", name: "Si fa battezzare", duration: 2, effects: [SetStat(stat: "iniziato_cristianesimo", value: 1), ModStat(stat: "santita", amount: 3)]),
        (id: "medita_forza", name: "Medita nella Forza", duration: 3,
