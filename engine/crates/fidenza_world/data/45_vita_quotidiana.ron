        (id: "elemosina", name: "Chiede l'elemosina", duration: 3, effects: [ModMoney(2.0), ModStat(stat: "reputazione", amount: -0.5)]),
        (id: "guarda_cantieri", name: "Guarda i cantieri", duration: 4, range: 3,
