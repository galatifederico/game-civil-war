        // Relazioni.
        (id: "corteggia", name: "Corteggia", duration: 2, range: 1,
         effects: [ModStat(stat: "fanatismo_sesso", amount: 0.5),
                   IfElse(Any([StatAtLeast(stat: "bellezza", value: 60), StatAtLeast(stat: "carisma", value: 18), StatAtLeast(stat: "baffi", value: 40)]),
                          ModBond(friendship: 2, attraction: 14), ModBond(attraction: 6)),
