        (id: "radi_baffi", name: "Si rade i baffi", duration: 1,
         effects: [SetStat(stat: "baffi", value: 0), ModStat(stat: "alpha_status", amount: -3), ModStat(stat: "bellezza", amount: 2)]),
        (id: "selfie", name: "Si fa un selfie", duration: 1,
