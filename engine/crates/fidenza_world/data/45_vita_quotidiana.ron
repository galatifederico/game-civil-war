        // Studio: ogni materia alza la sua conoscenza.
        (id: "studia_informatica", name: "Studia informatica", duration: 4, effects: [ModStat(stat: "con_informatica", amount: 1.5), ModStat(stat: "c_ore_studio", amount: 4), ModStat(stat: "stress", amount: 2), ModNeed(need: "riposo", amount: -0.1)]),
        (id: "studia_religione", name: "Studia il catechismo", duration: 4, effects: [ModStat(stat: "con_religione", amount: 1.5), ModStat(stat: "c_ore_studio", amount: 4), ModStat(stat: "stress", amount: 1)]),
        (id: "studia_medicina", name: "Studia medicina", duration: 4, effects: [ModStat(stat: "con_medicina", amount: 1.5), ModStat(stat: "c_ore_studio", amount: 4), ModStat(stat: "stress", amount: 3), ModNeed(need: "riposo", amount: -0.1)]),
        (id: "studia_magia_bianca", name: "Studia magia bianca", duration: 4, effects: [ModStat(stat: "con_magia_bianca", amount: 1.5), ModStat(stat: "mistica", amount: 0.3), ModStat(stat: "c_ore_studio", amount: 4)]),
        (id: "studia_agricoltura", name: "Studia agricoltura", duration: 4, effects: [ModStat(stat: "con_agricoltura", amount: 1.5), ModStat(stat: "c_ore_studio", amount: 4)]),
        (id: "pratica_arti_marziali", name: "Pratica arti marziali", duration: 4, effects: [ModStat(stat: "con_arti_marziali", amount: 1.5), ModStat(stat: "destrezza", amount: 0.1), ModStat(stat: "stress", amount: -2), ModNeed(need: "riposo", amount: -0.15)]),
        (id: "pratica_scherma", name: "Tira di scherma", duration: 4, effects: [ModStat(stat: "con_scherma", amount: 1.5), ModStat(stat: "destrezza", amount: 0.1), ModNeed(need: "riposo", amount: -0.1)]),
        (id: "fai_lavoretti", name: "Fa lavoretti di casa", duration: 4, effects: [ModStat(stat: "con_lavori_manuali", amount: 1.5), ModStat(stat: "forza", amount: 0.05)]),
        (id: "studia_legge", name: "Studia legge", duration: 4, effects: [ModStat(stat: "con_legge", amount: 1.5), ModStat(stat: "c_ore_studio", amount: 4), ModStat(stat: "stress", amount: 3)]),
        (id: "studia_giornalismo", name: "Studia giornalismo", duration: 4, effects: [ModStat(stat: "con_giornalismo", amount: 1.5), ModStat(stat: "c_ore_studio", amount: 4)]),
        (id: "studia_storia", name: "Studia la storia del team", duration: 4, effects: [ModStat(stat: "con_storia_team", amount: 1.5), ModStat(stat: "fanatismo_leader", amount: 0.5)]),
        (id: "studia_investigazione", name: "Legge gialli", duration: 4, effects: [ModStat(stat: "con_investigazione", amount: 1.5), ModStat(stat: "curiosita", amount: 0.2)]),
        (id: "studia_cucina", name: "Guarda programmi di cucina", duration: 3, effects: [ModStat(stat: "con_cucina", amount: 1.5), ModStat(stat: "grasso", amount: 0.2)]),
        (id: "degusta", name: "Fa una degustazione", duration: 2, range: 2,
