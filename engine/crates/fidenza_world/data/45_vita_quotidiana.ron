                   ModBond(friendship: -8), ModStat(stat: "alpha_status", amount: 0.5), ModStat(stat: "aggressivita", amount: 0.5)]),
        (id: "barzelletta", name: "Racconta una barzelletta", duration: 1, range: 2,
