                          All([ModStat(stat: "punti_gay", amount: 2), On(Target, ModStat(stat: "punti_gay", amount: 2))]),
                          All([ModStat(stat: "alpha_status", amount: 2), On(Target, ModStat(stat: "alpha_status", amount: 2))])),
                   SetStat(stat: "verginita", value: 0), On(Target, SetStat(stat: "verginita", value: 0)),
                   ModStat(stat: "c_partner", amount: 1), On(Target, ModStat(stat: "c_partner", amount: 1)),
                   ModNeed(need: "svago", amount: 0.6), On(Target, ModNeed(need: "svago", amount: 0.6)),
                   ModStat(stat: "stress", amount: -6), ModStat(stat: "fanatismo_sesso", amount: 1), ModBond(friendship: 5, attraction: 5),
                   If(Any([StatAtLeast(stat: "puzza", value: 50), OnTarget(StatAtLeast(stat: "puzza", value: 50))]), Chance(0.3, ApplyStatus(status: "std"))),
                   Custom(id: "concepisci")]),
        (id: "insulta", name: "Insulta", duration: 1, range: 2,
