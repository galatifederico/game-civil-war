// Vita quotidiana (docs/azioni.md): bere, lavarsi, studiare, pregare, rissa, sesso, canne, vizi, crimini piccoli,
// riti oscuri della Cripta, indagini. Ogni azione è un job (cosa succede) più un'azione dell'AI (quando conviene).
(
    fluids: [
        (id: "piscio", name: "Pipì", dirtiness: 1.5),
    ],
    statuses: [
        (id: "posseduto", name: "Posseduto", kind: Debuff, duration: 48, tags: ["mistico"],
         description: "Un demone della Cripta gli parla nella testa. Ci vuole un esorcista.",
         stats: {"aggressivita": 20, "santita": -10, "malinconia": 10, "sanita_mentale": -10}),
        (id: "maledetto", name: "Maledetto", kind: Debuff, duration: 48, tags: ["mistico", "maledizione"],
         description: "Gli gira tutto storto: perde fortuna e diventa paranoico.",
         stats: {"fortuna": -25, "paranoia": 15}),
        (id: "infezione", name: "Infezione", kind: Disease, duration: 24, tags: ["malattia"],
         description: "Tatuaggio fatto con l'ago del cugino.", stats: {"morale": -3}),
        (id: "cirrosi", name: "Fegato ingrossato", kind: Disease, progression: 0.005, tags: ["malattia"],
         description: "Il conto del Lambrusco arriva al fegato.",
         stages: [
            (name: "Fegato gonfio", at: 1.0, stats: {"resistenza": -2}),
            (name: "Cirrosi", at: 2.0, stats: {"resistenza": -5, "morale": -5}),
         ]),
        (id: "filtro_d_amore", name: "Sotto filtro d'amore", kind: Debuff, duration: 24, tags: ["mistico"],
         description: "Vede la strega della Bassa bellissima.", stats: {"fanatismo_sesso": 20}),
    ],
    items: [
        (id: "erba", name: "Erba", category: "sostanze", stack_max: 10, base_price: 6, tags: ["droga", "contrabbando"],
         description: "Da rollare: una canna, una LUCA o una SUPER LUCA."),
        (id: "luca", name: "LUCA", category: "sostanze", stack_max: 5, base_price: 18, tags: ["droga", "contrabbando", "fumo"],
         description: "Canna doppia.",
         on_use: [ModNeed(need: "svago", amount: 0.7), ApplyStatus(status: "fattone", severity: 2), ModStat(stat: "thc", amount: 30),
                  ModStat(stat: "stress", amount: -8), ModStat(stat: "c_canne", amount: 2), ModStat(stat: "tolleranza", amount: 1)]),
        (id: "super_luca_canna", name: "SUPER LUCA", category: "sostanze", stack_max: 5, base_price: 30, tags: ["droga", "contrabbando", "fumo"],
         description: "Leggendaria. Porta dritti allo stato di Super Luca.",
         on_use: [ModNeed(need: "svago", amount: 0.9), ApplyStatus(status: "fattone", severity: 3), ModStat(stat: "thc", amount: 50),
                  ModStat(stat: "stress", amount: -12), ModStat(stat: "c_canne", amount: 3), ModStat(stat: "tolleranza", amount: 1.5)]),
        (id: "anolini", name: "Anolini in brodo", category: "cibo", stack_max: 5, base_price: 9, tags: ["cibo", "carne"],
         on_use: [ModNeed(need: "fame", amount: 0.9), ModStat(stat: "stress", amount: -6), ModStat(stat: "morale", amount: 4), ModStat(stat: "grasso", amount: 0.6)]),
        (id: "torta_fritta", name: "Torta fritta", category: "cibo", stack_max: 5, base_price: 5, tags: ["cibo"],
         on_use: [ModNeed(need: "fame", amount: 0.6), ModNeed(need: "svago", amount: 0.2), ModStat(stat: "grasso", amount: 1.2)]),
        (id: "costume_cosplay", name: "Costume da cosplay", category: "vestiti", stack_max: 1, base_price: 40, tags: ["costume", "nerd"],
         description: "Fatto a mano con il cartone della pizza."),
        (id: "molotov", name: "Molotov", category: "lanciabili", stack_max: 5, base_price: 12, tags: ["arma", "contrabbando"], types: ["lanciabile", "incendiario"],
         damage: 12, range: 5, weight: 0.8, on_hit: [ApplyStatus(status: "ustionato")]),
    ],
    jobs: [
        // Bisogni e corpo.
        (id: "bevi_acqua", name: "Beve alla fontanella", duration: 1, effects: [ModNeed(need: "sete", amount: 0.8)]),
