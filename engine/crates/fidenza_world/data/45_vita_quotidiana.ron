        (id: "rolla_canna", name: "Rolla una canna", duration: 1, effects: [TakeItem(item: "erba"), GiveItem(item: "canna")]),
        (id: "rolla_luca", name: "Rolla una LUCA", duration: 1, effects: [TakeItem(item: "erba", qty: 2), GiveItem(item: "luca")]),
