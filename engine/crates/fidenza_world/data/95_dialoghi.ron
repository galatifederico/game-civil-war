// Frasi fatte delle pedine quando il campione ci parla. Si pescano dalle chiavi che corrispondono alla pedina
// (template:<id>, class:<id>, faction:<id>, race:<id>) più "default", che vale solo per le razze senza frasi proprie. Segnaposto: {name}, {faction}, {zone}, {player_name}.
// In futuro qui andranno anche gli indizi.
(
    dialogue: {
        "default": [
            "Bella giornata per stare a {zone}, eh?",
            "Hai sentito? Dicono che il Piccione Viaggiatore stampi solo bufale. Io però lo leggo lo stesso.",
            "Mio nonno diceva: a Fidenza o sei di qualcuno o sei di nessuno. Io sono di {faction}.",
            "Non ho tempo, devo andare al bar prima che finisca la birra.",
            "Il culatello di quest'anno è venuto bene. Peccato che costi come un rene.",
            "Ciao {player_name}! No aspetta, ti ho confuso con un altro.",
            "Le reliquie di San Donnino? Se le avessi non starei qui a parlare con te.",
            "Al Fidenza Village c'erano i saldi. Poi sono arrivati i rettiliani.",
            "Qui a {zone} non succede mai niente. Ieri però è successo di tutto.",
            "Mi hanno detto di non parlare con gli sconosciuti. Tu sei uno sconosciuto?",
            "Se cerchi guai, sei nel posto giusto. Se cerchi un parcheggio, no.",
            "La nebbia è tornata. O forse non se n'è mai andata.",
        ],
        "race:nano": [
            "Scava, scava, che sotto Fidenza c'è più roba che sopra.",
            "Il sale di Salso è buono, ma la pepita d'oro è meglio.",
            "Lassù c'è troppa luce. Mi fa venire il mal di testa.",
        ],
        "race:salsese": [
            "Noi di Salso abbiamo le terme. Voi di Fidenza avete... la rotonda.",
            "L'acqua salsobromoiodica cura tutto. Tranne l'antipatia per i fidentini.",
        ],
        "race:rettiliano": [
            "Io? Normalissimo umano. Perché mi guardi così?",
            "Ti piace il clima? Io lo preferirei più caldo. Molto più caldo.",
        ],
        "race:elfo_logistica": [
            "Consegna prevista tra due e trenta giorni lavorativi.",
            "Il capannone di Babbo Natale non dorme mai. Nemmeno ad agosto.",
        ],
        "race:robot": ["BIP. SALUTI, ESSERE UMANO. BIP.", "Errore 404: conversazione non trovata."],
        "race:droide": ["Bip bup biii-bup!", "Bup. (Sembra offeso.)"],
        "race:androide": ["Benvenuto, padrone! Ah no, non sei il mio padrone.", "Ho appena pulito qui. Non sporcare."],
        "race:intelligenza_artificiale": [
            "Come modello linguistico non posso avere opinioni su {zone}. Però mi fa schifo.",
            "Ho calcolato 14 milioni di futuri. In tutti finisce la birra.",
        ],
        "race:maiale": ["Oink.", "Oink oink! (Ti fissa con aria di rimprovero.)"],
        "race:zombie": ["Cerveeeelli... o anche un tortello, va bene uguale.", "Grrraaah."],
        "race:dinosauro": ["ROAAAR!", "(Ti annusa, poi decide che non vali la fatica.)"],
        "race:leone": ["(Sbadiglia mostrando tutti i denti.)"],
        "race:talpa": ["(Annusa l'aria cercando prosciutto.)"],
        "race:verme": ["(Si contorce in un modo vagamente frizzante.)"],
        "race:ragno": ["(Tesse una ragnatela che sa di soia.)"],
        "race:cinghiale": ["GRUNF!", "(Raspa la terra. Meglio andarsene.)"],
        "race:drone": ["Bzzzzz.", "(Ti scatta una foto e vola via.)"],
        "class:boomer": [
            "Ai miei tempi un caffè costava cento lire. E lo bevevamo in piedi!",
            "Questi giovani col telefono... Aspetta, come si mandano le foto su WhatsApp?",
            "Sono andato a vedere i lavori della rotonda. Fanno tutto sbagliato.",
        ],
        "class:giornalista": [
            "Hai uno scoop? Pago bene. Cioè, pago. Cioè, ti cito.",
            "Domani in prima pagina: «{player_name} parla con un giornalista». Grande notizia.",
        ],
        "class:poliziotto": [
            "Circolare, circolare. Non c'è niente da vedere.",
            "Documenti, prego. Scherzo. O forse no.",
        ],
        "class:polizia_vegana": ["Hai mangiato carne oggi? Rispondi con sincerità.", "La soia vede tutto."],
        "class:medico": ["Hai una brutta cera. Torna quando sei più malato, che ora sono pieno.", "Lavati le mani. Sempre."],
        "class:ninja": ["...", "(Era qui un attimo fa.)"],
        "class:mago_vergine": ["La mia magia è potentissima. Ancora.", "Non ho tempo per le donne: studio incantesimi."],
        "class:jedi": ["Che la Forza sia con te. E anche il Lambrusco."],
        "class:sith": ["Unisciti al lato oscuro: abbiamo i tortelli."],
        "class:hacker": ["Ho bucato il wi-fi del Comune. La password era «fidenza1».", "sudo dammi i soldi"],
        "class:agricoltore": ["Se non piove la colpa è del governo. Se piove pure.", "Il pomodoro quest'anno è venuto piccolo ma cattivo."],
        "class:allevatore": ["I maiali sono più intelligenti di tanta gente che conosco."],
        "class:spia": ["Non mi hai visto. Non ci siamo parlati.", "Bel tempo, vero? (Ti scruta un po' troppo.)"],
        "faction:chiesa": ["Hai acceso un cero a San Donnino oggi?", "Le reliquie appartengono alla Chiesa. Tutte. Anche quelle che non lo sanno."],
        "faction:cripta_san_vitale": ["Scendi nella Cripta, una volta. Se risali, ne parliamo."],
        "faction:cda_fidenza_village": ["Ha già visitato il nostro outlet? Sconti fino al 70% sulla sua anima.", "Il Consiglio approva questa conversazione."],
        "faction:anarchici_commercio": ["Il mercato libero è libero di fare quello che vogliamo noi.", "Abbasso i prezzi! Cioè, dipende di chi."],
        "faction:templari_borgo": ["Il Borgo resiste. Da secoli. Più o meno.", "Non deus vult, deus Borgo."],
        "faction:contadini_bassa": ["Senza di noi mangereste i sassi. Anzi, i nani li mangerebbero.", "La Bassa ha nebbia, zanzare e il miglior culatello del mondo."],
        "faction:casino_diablo": ["Vuoi tentare la fortuna? La casa vince sempre, ma tu forse no.", "Qui dentro il tempo non passa. Il conto sì."],
        "faction:circolo_boomer": ["Al Circolo c'è la briscola alle sei. Non tardare."],
        "faction:gilda_nerd": ["Han ha sparato per primo. Fine della discussione.", "Ho ancora la prima edizione. In bustina. Non toccare."],
        "faction:impero_vegano": ["Il Monolite di Soia ti osserva.", "Ti offrirei un estratto, ma prima devi meritarlo."],
        "faction:ubriaconi": ["Hic! Lunga vita a Re Anolino! Hic!", "Il trono degli Ubriaconi si conquista con il fegato."],
        "faction:babbo_natale": ["Ad agosto qui è Natale. Non chiedere perché.", "Sei nella lista dei buoni? Controllo... no."],
        "faction:istituzioni": ["La Repubblica è vicina ai cittadini. Ma non troppo.", "Compili il modulo B-27 e ripassi martedì."],
        "faction:redazione_gazzetta": ["La Gazzetta dice sempre la verità. Quando conviene."],
        "faction:polizia_neutra": ["La legge è uguale per tutti. Le tangenti no."],
