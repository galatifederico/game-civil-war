// Il mondo: giocatore, popolazione iniziale, dungeon, trigger, successione, stampa, vittoria, grafica.
(
    placements: [
        Player(id: "giocatore", name: "Giocatore", faction: "anarchici_commercio"),

        // Piazza Garibaldi: la scena della demo.
        Entity(template: "leader_anarchico", zone: "piazza_garibaldi", at: (97, 45), leader_of: "giocatore"),
        Entity(template: "scippatore", zone: "piazza_garibaldi", at: (101, 46), name: "Tommy lo Scippatore"),
        Entity(template: "commerciante_ricco", zone: "piazza_garibaldi", at: (102, 47), name: "Sior Ernesto"),
        Entity(template: "agente", zone: "piazza_garibaldi", at: (106, 48), name: "Agente Scelto Ferrari"),
        Entity(template: "cronista", zone: "piazza_garibaldi", at: (99, 44), name: "Lucia Taccuino"),
        Entity(template: "fidentino", count: 4, zone: "piazza_garibaldi"),
        Entity(template: "gerolamo_borgazzi", zone: "piazza_garibaldi", at: (108, 37)),
        Entity(template: "oracolo", zone: "piazza_garibaldi", at: (92, 35)),

        // Istituzioni e fazioni.
        Entity(template: "commissario", zone: "stazione_polizia"),
        Entity(template: "agente", count: 2, zone: "stazione_polizia"),
        Entity(template: "direttore_testata", zone: "redazione"),
        Entity(template: "cronista", zone: "salsomaggiore_terme"),
        Entity(template: "vescovo", zone: "duomo_interno"),
        Entity(template: "prete", count: 2, zone: "duomo_interno"),
        Entity(template: "medico", zone: "cattedrale"),
        Entity(template: "re_anolino", zone: "trono_ubriaconi"),
        Entity(template: "ubriacone", count: 4, zone: "bar_ubriaconi"),
        Entity(template: "yag", zone: "bar_ubriaconi"),
        Entity(template: "gabriele_del_commercio", zone: "piazza_garibaldi"),
        Entity(template: "ninja", zone: "piazza_garibaldi"),
        Entity(template: "spia", zone: "fidenza_village"),
        Entity(template: "chimico", zone: "piazza_garibaldi"),
        Entity(template: "muratore", zone: "piazza_garibaldi"),
        Entity(template: "presidente_cda", zone: "outlet_interno"),
        Entity(template: "consigliere_cda", count: 2, zone: "fidenza_village"),
        Entity(template: "commesso_rettiliano", count: 2, zone: "fidenza_village"),
        Entity(template: "boomer_overmind", zone: "circolo_boomer"),
        Entity(template: "boomer", count: 3, zone: "circolo_boomer"),
        Entity(template: "nerd", count: 2, zone: "fumetteria"),
        Entity(template: "goth", count: 3, zone: "piazza_garibaldi"),
        Entity(template: "morticia", zone: "cripta"),
        Entity(template: "lord_tenebra", zone: "piazza_garibaldi"),
        Entity(template: "mago_vergine", zone: "fumetteria"),
        Entity(template: "gran_sacerdote_tofu", zone: "impero_vegano"),
        Entity(template: "mistico_vegano", count: 2, zone: "impero_vegano"),
        Entity(template: "inquisitore_soia", zone: "impero_vegano"),
        Entity(template: "alex_innerfire", zone: "borgo_templari"),
        Entity(template: "cavaliere_templare", count: 2, zone: "borgo_templari"),
        Entity(template: "jedi", zone: "borgo_templari"),
        Entity(template: "diablo", zone: "sala_casino"),
        Entity(template: "massone", count: 3, zone: "piazza_garibaldi"),
        Entity(template: "gran_maestro_loggia", zone: "piazza_garibaldi"),
        Entity(template: "croupier", count: 2, zone: "casino"),
        Entity(template: "sith", zone: "casino"),
        Entity(template: "contadino", count: 3, zone: "campagna_bassa"),
        Entity(template: "allevatore", zone: "campagna_bassa"),
        Entity(template: "fornaio", count: 2, zone: "campagna_bassa"),
        Entity(template: "salsese", count: 4, zone: "salsomaggiore_terme"),
        Entity(template: "babbo_natale_estivo", zone: "capannone_regali"),
        Entity(template: "elfo_logistica", count: 5, zone: "capannone_regali", tether: (zone: "capannone_regali", release: Never)),
        Entity(template: "capo_dei_nani", zone: "gallerie"),
        Entity(template: "minatore", count: 5, zone: "gallerie"),
        Entity(template: "gran_custode", zone: "cripta"),

    ],
    events: [
        (id: "talpe", every: 24, effects: [Spawn(template: "talpa_del_prosciutto", zone: Some("miniere_profonde"), faction: Some("fauna_selvatica"), tether: Some((zone: "miniere_profonde", release: Never)), max_alive: 4)]),
        (id: "vermi", every: 24, effects: [Spawn(template: "verme_del_lambrusco", zone: Some("caverne"), faction: Some("fauna_selvatica"), tether: Some((zone: "caverne", release: Never)), max_alive: 3)]),
        (id: "ragni", every: 24, effects: [Spawn(template: "ragno_di_soia", zone: Some("caverne"), faction: Some("fauna_selvatica"), tether: Some((zone: "caverne", release: Never)), max_alive: 4)]),
        (id: "cinghiali", every: 36, effects: [Spawn(template: "cinghiale", zone: Some("bosco_stirone"), faction: Some("fauna_selvatica"), tether: Some((zone: "bosco_stirone", release: Never)), max_alive: 3)]),
        (id: "zombie_catacombe", every: 12, effects: [Spawn(template: "zombie", zone: Some("catacombe"), faction: Some("cripta_san_vitale"), tether: Some((zone: "catacombe", release: Flag(flag: "cripta_aperta", min: 1))), max_alive: 6)]),
        (id: "arrivi_fidentini", every: 12, when: PopulationBelow(template: "fidentino", count: 6), effects: [Spawn(template: "fidentino", zone: Some("piazza_garibaldi"))]),
        (id: "arrivi_salsesi", every: 12, when: PopulationBelow(template: "salsese", count: 6), effects: [Spawn(template: "salsese", zone: Some("salsomaggiore_terme"))]),
        (id: "arrivi_contadini", every: 24, when: PopulationBelow(template: "contadino", count: 7), effects: [Spawn(template: "contadino", zone: Some("campagna_bassa"))]),
        (id: "arrivi_fornai", every: 24, when: PopulationBelow(template: "fornaio", count: 4), effects: [Spawn(template: "fornaio", zone: Some("campagna_bassa"))]),
        (id: "arrivi_agenti", every: 24, when: PopulationBelow(template: "agente", count: 4), effects: [Spawn(template: "agente", zone: Some("stazione_polizia"))]),
        (id: "arrivi_cronisti", every: 24, when: PopulationBelow(template: "cronista", count: 3), effects: [Spawn(template: "cronista", zone: Some("redazione"))]),
        (id: "arrivi_ubriaconi", every: 24, when: PopulationBelow(template: "ubriacone", count: 4), effects: [Spawn(template: "ubriacone", zone: Some("bar_ubriaconi"))]),
        (id: "arrivi_preti", every: 48, when: PopulationBelow(template: "prete", count: 2), effects: [Spawn(template: "prete", zone: Some("cattedrale"))]),
        (id: "arrivi_templari", every: 48, when: PopulationBelow(template: "cavaliere_templare", count: 2), effects: [Spawn(template: "cavaliere_templare", zone: Some("borgo_templari"))]),
        (id: "arrivi_boomer", every: 48, when: PopulationBelow(template: "boomer", count: 3), effects: [Spawn(template: "boomer", zone: Some("circolo_boomer"))]),
        (id: "arrivi_goth", every: 48, when: PopulationBelow(template: "goth", count: 2), effects: [Spawn(template: "goth", zone: Some("piazza_garibaldi"))]),
        (id: "arrivi_nerd", every: 48, when: PopulationBelow(template: "nerd", count: 2), effects: [Spawn(template: "nerd", zone: Some("fumetteria"))]),
        (id: "arrivi_mistici", every: 48, when: PopulationBelow(template: "mistico_vegano", count: 2), effects: [Spawn(template: "mistico_vegano", zone: Some("impero_vegano"))]),
        (id: "arrivi_croupier", every: 48, when: PopulationBelow(template: "croupier", count: 2), effects: [Spawn(template: "croupier", zone: Some("casino"))]),
        (id: "arrivi_minatori", every: 48, when: PopulationBelow(template: "minatore", count: 6), effects: [Spawn(template: "minatore", zone: Some("miniera"))]),
        (id: "arrivi_medici", every: 72, when: PopulationBelow(template: "medico", count: 1), effects: [Spawn(template: "medico", zone: Some("cattedrale"))]),
        (id: "arrivi_elfi", every: 24, when: PopulationBelow(template: "elfo_logistica", count: 5), effects: [Spawn(template: "elfo_logistica", zone: Some("capannone_regali"), tether: Some((zone: "capannone_regali", release: Never)))]),
        (id: "dinosauri", every: 24, by: Some("capo_dei_nani"), effects: [Spawn(template: "dinosauro", zone: Some("tana_dinosauri"), faction: Some("nani_miniere"), tether: Some((zone: "gallerie", release: Flag(flag: "gallerie_violate", min: 1))), max_alive: 2)]),
        (id: "robot_rotonde", every: 24, by: Some("boomer_overmind"), effects: [Spawn(template: "robot", zone: Some("rotonde"), faction: Some("circolo_boomer"), tether: Some((zone: "rotonde", release: Flag(flag: "overmind_allerta", min: 1))), max_alive: 3)]),
        (id: "droni", every: 36, by: Some("boomer_overmind"), effects: [Spawn(template: "drone", zone: Some("circolo_boomer"), faction: Some("circolo_boomer"), tether: Some((zone: "circolo_boomer", release: Flag(flag: "overmind_allerta", min: 1))), max_alive: 2)]),
        (id: "zombie", every: 12, by: Some("gran_custode"), effects: [Spawn(template: "zombie", zone: Some("cripta"), faction: Some("cripta_san_vitale"), tether: Some((zone: "cripta", release: Flag(flag: "cripta_aperta", min: 1))), max_alive: 4)]),
        (id: "droidi", every: 48, effects: [Spawn(template: "droide_r2", zone: Some("fumetteria"), faction: Some("gilda_nerd"), tether: Some((zone: "fumetteria", release: BuildingHpBelow(building: "fumetteria", ratio: 0.8))), max_alive: 1)]),
        (id: "waifu", every: 48, effects: [Spawn(template: "waifu", zone: Some("fumetteria"), faction: Some("gilda_nerd"), tether: Some((zone: "fumetteria", release: BuildingHpBelow(building: "fumetteria", ratio: 0.8))), max_alive: 1)]),
        (id: "maid", every: 72, effects: [Spawn(template: "maid", zone: Some("fumetteria"), faction: Some("gilda_nerd"), tether: Some((zone: "fumetteria", release: BuildingHpBelow(building: "fumetteria", ratio: 0.8))), max_alive: 1)]),
        (id: "leoni", every: 48, by: Some("diablo"), effects: [Spawn(template: "leone", zone: Some("casino"), faction: Some("casino_diablo"), tether: Some((zone: "casino", release: Flag(flag: "crediti_insoluti", min: 1))), max_alive: 2)]),
        (id: "nani_scavano", name: "I Nani allargano la fortezza", when: TemplateAlive("capo_dei_nani"), every: 6, effects: [Custom(id: "dig_frontier", params: {"zone": "#fortezza", "faction": "nani_miniere", "count": 4, "max_open": 14})]),
        (id: "oracolo_assegnazione", name: "L'Oracolo sceglie da che parte stare", when: TickAtLeast(0), effects: [Custom(id: "oracle_assign")]),
        (id: "oracolo_rivelazione", name: "L'Oracolo parla", when: All([TickAtLeast(12), TemplateAlive("oracolo")]), every: 96, effects: [Custom(id: "oracle_reveal")]),
        (id: "gallerie_violate", name: "Intrusi nelle Gallerie dei Nani!", when: Custom(id: "intruders", params: {"zone": "gallerie", "faction": "nani_miniere", "min": 1}), news: 0.7, effects: [SetFlag(flag: "gallerie_violate", value: 1)]),
        (id: "overmind_allerta", name: "L'Overmind dichiara lo stato d'allerta", when: Any([TickAtLeast(96), Custom(id: "intruders", params: {"zone": "circolo_boomer", "faction": "circolo_boomer", "min": 2})]), news: 0.8, effects: [SetFlag(flag: "overmind_allerta", value: 1),
                   Publish(headline: "ALLERTA: l'Overmind attiva i robot delle rotonde. Restate in casa (e comprate gnomi).", truth: Propaganda, topics: ["bufala", "allerta"])]),
        (id: "cripta_aperta", name: "La Cripta di San Vitale si apre", when: TickAtLeast(144), news: 0.9, effects: [SetFlag(flag: "cripta_aperta", value: 1)]),
        (id: "crediti_insoluti", name: "Il Casinò esige i crediti", when: TickAtLeast(60), effects: [SetFlag(flag: "crediti_insoluti", value: 1)]),
        (id: "opera_del_borgazzi", name: "Il Borgazzi dipinge", when: All([TickAtLeast(10), TemplateAlive("gerolamo_borgazzi")]), every: 48, effects: [Custom(id: "borgazzi_masterpiece")]),
        (id: "visita_presidenziale", name: "Visita del Presidente della Repubblica", when: TickAtLeast(30), news: 0.6, effects: [Spawn(template: "presidente_repubblica", count: 1, zone: "piazza_garibaldi"),
                   Publish(headline: "Il Presidente della Repubblica in visita a Fidenza: «Che bella rotonda»", truth: Real, topics: ["politica"])]),
        (id: "epidemia_terme", name: "Epidemia alle Terme di Salsomaggiore", when: TickAtLeast(150), news: 1.0, effects: [On(Zone("salsomaggiore_terme"), Chance(0.4, ApplyStatus(status: "diarrea"))),
                   Publish(headline: "Emergenza sanitaria alle Terme: chiuse le piscine, la Cripta nega ogni responsabilità", truth: Real, topics: ["epidemia", "salso"])]),
        (id: "re_morto", name: "Il Re è morto", when: TemplateDead("re_anolino"), news: 1.0, effects: [Publish(headline: "Re Anolino è morto! Il Trono degli Ubriaconi è vacante", truth: Real, topics: ["succession"])]),
        (id: "propaganda_chiesa", description: "Fonte di notizie automatica: un titolo diverso ogni volta, a turno.", by: Some("vescovo"), from_tick: 20, every: 120, effects: [Cycle([
            All([Publish(headline: "Il Vescovo: «Chi custodisce la Testa di San Donnino custodisce Fidenza»", truth: Propaganda, topics: ["propaganda", "chiesa"])]),
            All([Publish(headline: "Messa in piazza: offerte raddoppiate, peccati dimezzati", truth: Propaganda, topics: ["propaganda", "chiesa"]), ModTreasury(50)]),
         ])]),
        (id: "propaganda_vegana", description: "Fonte di notizie automatica: un titolo diverso ogni volta, a turno.", by: Some("gran_sacerdote_tofu"), from_tick: 30, every: 120, effects: [Cycle([
            All([Publish(headline: "Il Gran Sacerdote del Tofu: «La soia è l'unica reliquia che conta»", truth: Propaganda, topics: ["propaganda", "vegano"])]),
            All([Publish(headline: "Studio indipendente (nostro): il culatello causa l'alopecia", truth: Propaganda, topics: ["propaganda", "vegano", "carne"])]),
         ])]),
        (id: "propaganda_cda", description: "Fonte di notizie automatica: un titolo diverso ogni volta, a turno.", by: Some("presidente_cda"), from_tick: 40, every: 144, effects: [Cycle([
            All([Publish(headline: "Fidenza Village: saldi del 70% su tutto, rettili esclusi", truth: Propaganda, topics: ["propaganda", "shopping"])]),
            All([Publish(headline: "Il CdA smentisce: «Nessun rettiliano nel consiglio. Sssssì, nessuno»", truth: Propaganda, topics: ["propaganda"])]),
         ])]),
        (id: "overmind_fake_news", description: "Fonte di notizie automatica: un titolo diverso ogni volta, a turno.", by: Some("boomer_overmind"), from_tick: 0, every: 48, effects: [Cycle([
            All([Publish(headline: "I Vegani vogliono vietare il culatello: firmate la petizione!", truth: Fake, topics: ["bufala", "vegano"])]),
            All([Publish(headline: "Gli Elfi della Logistica rubano il Wi-Fi ai pensionati", truth: Fake, topics: ["bufala", "logistica"])]),
            All([Publish(headline: "5G nelle rotonde: ecco perché ti fa male la cervicale", truth: Fake, topics: ["bufala"])]),
            All([Publish(headline: "Il Monolite di Soia emette radiazioni gender", truth: Fake, topics: ["bufala", "vegano"])]),
            All([Publish(headline: "Si dice che i Salsesi mettano l'acqua nel Lambrusco", truth: Fake, topics: ["bufala", "salso"]), On(Template("salsese"), ModStat(stat: "morale", amount: -3))]),
         ])]),
    ],
    press: (
        feed_name: "Il Piccione Viaggiatore",
        default_headline: "{message}",
        headlines: {
            "arrest": ["Manette in Piazza: {actor} arresta {target}", "ARRESTATO {target}! Fidenza tira un sospiro di sollievo"],
            "crime": ["Fattaccio in pieno centro: {message}", "Paura a Fidenza: {message}"],
            "seizure": ["Maxi-sequestro: {message}"],
            "search": ["Perquisizione in piazza: {actor} fruga le tasche di {target}"],
            "bribe": ["Tangentopoli della Bassa: {faction} compra il silenzio della Polizia"],
            "exposed": ["CLAMOROSO: {message}"],
            "death": ["Lutto cittadino: {message}"],
            "mutilation": ["Sangue in strada: {message}"],
            "transmutation": ["Scienza o magia? {message}"],
            "pig_mutation": ["Emergenza porcina: {message}"],
            "succession": ["Viva il Re! {message}"],
            "succession_open": ["{message}"],
            "tether_released": ["Invasione! {message}"],
            "structure_damage": ["Crolli e disagi: {message}"],
            "collection_completed": ["Colpo grosso: {message}"],
        },
        publish_work: 2,
        important_threshold: 0.7,
        default_category: "varie",
        categories: [
            (id: "chiacchiere", name: "Chiacchiere", weight: 0.5,
             topics: ["bufala", "propaganda", "gossip", "oracolo"]),
            (id: "politica", name: "Politica", weight: 1.1,
             topics: ["succession", "succession_open", "politics", "alliance", "merge", "defection", "politica", "victory"]),
            (id: "cronaca", name: "Cronaca",
             topics: ["crime", "arrest", "seizure", "search", "bribe", "death", "mutilation", "exposed", "violence", "furto_sacrilego", "knocked_out"]),
            (id: "salute", name: "Salute",
             topics: ["epidemia", "pig_mutation", "transmutation", "infection", "contagion", "malattia"]),
            (id: "economia", name: "Economia",
             topics: ["economy", "unpaid", "structure_damage", "consequence", "collection_completed", "market", "shopping"]),
            (id: "eventi", name: "Eventi",
             topics: ["tether_released", "surface_raid", "allerta", "trigger", "masterpiece", "reliquia", "global"]),
        ],
    ),
    news_impacts: [
        (topic: "epidemia", market: [("medicina", 1.8, 1.0), ("cibo", 1.2, 1.0)], duration: 72, morale: -2),
        (topic: "propaganda", morale: 1),
        (topic: "arrest", market: [("contrabbando", 1.6, 0.7), ("alcol", 1.2, 1.0)], duration: 48, subject_reputation: -10, relation: -5, morale: 1),
        (topic: "seizure", market: [("contrabbando", 1.3, 0.8)], duration: 48),
        (topic: "crime", market: [("lusso", 0.9, 1.0)], duration: 24, morale: -0.5),
        (topic: "bribe", subject_reputation: -15, relation: -10, morale: -1),
        (topic: "exposed", market: [("lusso", 0.7, 1.0)], duration: 72, subject_reputation: -30, morale: -1),
        (topic: "bufala", market: [("vegano", 0.8, 1.0)], duration: 24, morale: -0.3, fake_factor: 1.0),
        (topic: "pig_mutation", market: [("carne", 0.6, 1.2), ("medicina", 1.6, 1.0)], duration: 72, morale: -1),
        (topic: "death", morale: -0.5),
        (topic: "structure_damage", market: [("merce", 1.3, 0.9)], duration: 48),
        (topic: "succession", morale: 5),
    ],
    victory: [
        (id: "reliquie", name: "Il Corpo di San Donnino", primary: true, kind: HoldItems(["gamba_destra", "gamba_sinistra", "testa_san_donnino", "mano_destra", "mano_sinistra"]),
         description: "Riunire le cinque reliquie maggiori."),
        (id: "trono", name: "Il Trono degli Ubriaconi", kind: HoldTitle("trono_degli_ubriaconi"),
         description: "Mettere il proprio leader sul Trono degli Ubriaconi dopo la morte di Re Anolino."),
        (id: "punti", name: "Egemonia", kind: VictoryPoints(3000), description: "Accumulare 3000 punti vittoria."),
    ],
    sprites: {
        "race:fidentino": (shape: "circle", color: "#e8b98a", glyph: "F", sheet: "chibi_fidentino"),
        "race:salsese": (shape: "circle", color: "#d9a0a0", glyph: "S", sheet: "chibi_salsese"),
        "race:nano": (shape: "circle", color: "#b07040", glyph: "N", sheet: "chibi_nano"),
        "race:elfo_logistica": (shape: "circle", color: "#7fd18b", glyph: "E", sheet: "chibi_elfo_logistica"),
        "race:rettiliano": (shape: "diamond", color: "#4caf50", glyph: "R", sheet: "chibi_rettiliano"),
        "race:maiale": (shape: "circle", color: "#f4a6b8", glyph: "M", sheet: "chibi_maiale"),
        "race:dinosauro": (shape: "triangle", color: "#5d8a3a", glyph: "D", sheet: "chibi_dinosauro"),
        "race:robot": (shape: "square", color: "#9e9e9e", glyph: "R", sheet: "chibi_robot"),
        "race:drone": (shape: "triangle", color: "#607d8b", glyph: "d", sheet: "chibi_drone"),
        "race:zombie": (shape: "circle", color: "#8bc34a", glyph: "Z", sheet: "chibi_zombie"),
        "race:droide": (shape: "square", color: "#90caf9", glyph: "R2", sheet: "chibi_droide"),
        "race:androide": (shape: "circle", color: "#f8bbd0", glyph: "W", sheet: "chibi_androide"),
        "race:leone": (shape: "triangle", color: "#ffb300", glyph: "L", sheet: "chibi_leone"),
        "race:talpa": (shape: "circle", color: "#5b4a42", glyph: "T", sheet: "chibi_talpa"),
        "race:verme": (shape: "circle", color: "#9c2a4a", glyph: "V", sheet: "chibi_verme"),
        "race:ragno": (shape: "circle", color: "#c8b78a", glyph: "Rg", sheet: "chibi_ragno"),
        "race:cinghiale": (shape: "circle", color: "#6d4c33", glyph: "C", sheet: "chibi_cinghiale"),
        "class:poliziotto": (sheet: "acc_cap_polizia"),
        "class:cavaliere": (sheet: "acc_elmo"),
        "class:mago_vergine": (sheet: "acc_cappello_mago"),
        "class:ninja": (sheet: "acc_fascia_ninja"),
        "class:vegano": (sheet: "acc_corona_foglie"),
        "class:polizia_vegana": (sheet: "acc_corona_foglie"),
        "class:jedi": (sheet: "acc_cappuccio"),
        "class:sith": (sheet: "acc_cappuccio_sith"),
        "class:goth": (sheet: "acc_goth"),
        "class:medico": (sheet: "acc_berretto_medico"),
        "class:chimico": (sheet: "acc_berretto_medico"),
        "class:boomer": (sheet: "acc_cappellino_boomer"),
        "class:giornalista": (sheet: "acc_fedora_stampa"),
        "class:yag": (sheet: "acc_aureola"),
        "faction:polizia_neutra": (outline: "#1e3a8a"),
        "faction:redazione_gazzetta": (outline: "#111111"),
        "faction:anarchici_commercio": (outline: "#d32f2f"),
        "faction:chiesa": (outline: "#fbc02d"),
        "faction:cda_fidenza_village": (outline: "#6a1b9a"),
        "faction:impero_vegano": (outline: "#2e7d32"),
        "faction:ubriaconi": (outline: "#8d6e63"),
