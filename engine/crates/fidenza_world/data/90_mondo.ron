        "building:vigna": (sheet: "bld_vigna"),
        "building:stendardo": (sheet: "bld_stendardo"),
        "building:osteria": (sheet: "bld_osteria"),
        "building:bocciofila": (sheet: "bld_bocciofila"),
        "building:cinema": (sheet: "bld_cinema"),
        "building:sala_slot": (sheet: "bld_sala_slot"),
        "building:parco_giochi": (sheet: "bld_parco_giochi"),
        "building:campetto": (sheet: "bld_campetto"),
        "building:balera": (sheet: "bld_balera"),
        "building:gelateria": (sheet: "bld_gelateria"),
        "building:deposito": (sheet: "bld_deposito"),
