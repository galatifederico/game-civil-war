        Building(building: "banco_mercato", zone: "piazza_garibaldi", at: (38, 22), owner_faction: "anarchici_commercio"),
        Building(building: "cattedrale", zone: "cattedrale", at: (49, 23), owner_faction: "chiesa"),
        Building(building: "banchetto_santini", zone: "cattedrale", at: (47, 21), owner_faction: "chiesa"),
        Building(building: "mensa_poveri", zone: "cattedrale", at: (51, 21), owner_faction: "chiesa"),
        Building(building: "laboratorio_medico", zone: "cattedrale", at: (52, 26), owner_faction: "chiesa"),
