// Il mondo: giocatore, popolazione iniziale, dungeon, trigger, successione, stampa, vittoria, grafica.
(
    placements: [
        Player(id: "giocatore", name: "Giocatore", faction: "anarchici_commercio"),

        // Piazza Garibaldi: la scena della demo.
        Entity(template: "leader_anarchico", zone: "piazza_garibaldi", at: (97, 45), leader_of: "giocatore"),
        Entity(template: "scippatore", zone: "piazza_garibaldi", at: (101, 46), name: "Tommy lo Scippatore"),
        Entity(template: "commerciante_ricco", zone: "piazza_garibaldi", at: (102, 47), name: "Sior Ernesto"),
        Entity(template: "agente", zone: "piazza_garibaldi", at: (106, 48), name: "Agente Scelto Ferrari"),
        Entity(template: "cronista", zone: "piazza_garibaldi", at: (99, 44), name: "Lucia Taccuino"),
        Entity(template: "fidentino", count: 4, zone: "piazza_garibaldi"),
        Entity(template: "gerolamo_borgazzi", zone: "piazza_garibaldi", at: (108, 37)),
        Entity(template: "oracolo", zone: "piazza_garibaldi", at: (92, 35)),

        // Istituzioni e fazioni.
        Entity(template: "commissario", zone: "stazione_polizia"),
        Entity(template: "agente", count: 2, zone: "stazione_polizia"),
        Entity(template: "direttore_testata", zone: "redazione"),
        Entity(template: "cronista", zone: "salsomaggiore_terme"),
        Entity(template: "vescovo", zone: "duomo_interno"),
        Entity(template: "prete", count: 2, zone: "duomo_interno"),
        Entity(template: "medico", zone: "cattedrale"),
        Entity(template: "re_anolino", zone: "trono_ubriaconi"),
        Entity(template: "ubriacone", count: 4, zone: "bar_ubriaconi"),
        Entity(template: "yag", zone: "bar_ubriaconi"),
        Entity(template: "gabriele_del_commercio", zone: "piazza_garibaldi"),
        Entity(template: "ninja", zone: "piazza_garibaldi"),
        Entity(template: "spia", zone: "fidenza_village"),
        Entity(template: "chimico", zone: "piazza_garibaldi"),
        Entity(template: "muratore", zone: "piazza_garibaldi"),
        Entity(template: "presidente_cda", zone: "outlet_interno"),
        Entity(template: "consigliere_cda", count: 2, zone: "fidenza_village"),
        Entity(template: "commesso_rettiliano", count: 2, zone: "fidenza_village"),
        Entity(template: "boomer_overmind", zone: "circolo_boomer"),
        Entity(template: "boomer", count: 3, zone: "circolo_boomer"),
        Entity(template: "nerd", count: 2, zone: "fumetteria"),
        Entity(template: "goth", count: 3, zone: "piazza_garibaldi"),
        Entity(template: "morticia", zone: "cripta"),
        Entity(template: "lord_tenebra", zone: "piazza_garibaldi"),
        Entity(template: "mago_vergine", zone: "fumetteria"),
        Entity(template: "gran_sacerdote_tofu", zone: "impero_vegano"),
        Entity(template: "mistico_vegano", count: 2, zone: "impero_vegano"),
        Entity(template: "inquisitore_soia", zone: "impero_vegano"),
        Entity(template: "alex_innerfire", zone: "borgo_templari"),
        Entity(template: "cavaliere_templare", count: 2, zone: "borgo_templari"),
        Entity(template: "jedi", zone: "borgo_templari"),
        Entity(template: "diablo", zone: "sala_casino"),
        Entity(template: "massone", count: 3, zone: "piazza_garibaldi"),
        Entity(template: "gran_maestro_loggia", zone: "piazza_garibaldi"),
        Entity(template: "croupier", count: 2, zone: "casino"),
        Entity(template: "sith", zone: "casino"),
        Entity(template: "contadino", count: 3, zone: "campagna_bassa"),
        Entity(template: "allevatore", zone: "campagna_bassa"),
        Entity(template: "fornaio", count: 2, zone: "campagna_bassa"),
        Entity(template: "salsese", count: 4, zone: "salsomaggiore_terme"),
        Entity(template: "babbo_natale_estivo", zone: "capannone_regali"),
        Entity(template: "elfo_logistica", count: 5, zone: "capannone_regali", tether: (zone: "capannone_regali", release: Never)),
        Entity(template: "capo_dei_nani", zone: "gallerie"),
        Entity(template: "minatore", count: 5, zone: "gallerie"),
        Entity(template: "gran_custode", zone: "cripta"),

    ],
    spawners: [
        // Fauna delle profondità e del bosco: resta nel suo territorio e attacca chi entra.
        (id: "talpe", template: "talpa_del_prosciutto", zone: "miniere_profonde", interval: 24, max_alive: 4, faction: "fauna_selvatica",
         tether: (zone: "miniere_profonde", release: Never)),
        (id: "vermi", template: "verme_del_lambrusco", zone: "caverne", interval: 24, max_alive: 3, faction: "fauna_selvatica",
         tether: (zone: "caverne", release: Never)),
        (id: "ragni", template: "ragno_di_soia", zone: "caverne", interval: 24, max_alive: 4, faction: "fauna_selvatica",
         tether: (zone: "caverne", release: Never)),
        (id: "cinghiali", template: "cinghiale", zone: "bosco_stirone", interval: 36, max_alive: 3, faction: "fauna_selvatica",
         tether: (zone: "bosco_stirone", release: Never)),
        (id: "zombie_catacombe", template: "zombie", zone: "catacombe", interval: 12, max_alive: 6, faction: "cripta_san_vitale",
         tether: (zone: "catacombe", release: Flag(flag: "cripta_aperta", min: 1))),
        // Immigrazione: chi muore viene rimpiazzato da nuovi arrivi.
        (id: "arrivi_fidentini", template: "fidentino", zone: "piazza_garibaldi", interval: 12, active_when: PopulationBelow(template: "fidentino", count: 6)),
        (id: "arrivi_salsesi", template: "salsese", zone: "salsomaggiore_terme", interval: 12, active_when: PopulationBelow(template: "salsese", count: 6)),
        (id: "arrivi_contadini", template: "contadino", zone: "campagna_bassa", interval: 24, active_when: PopulationBelow(template: "contadino", count: 7)),
        (id: "arrivi_fornai", template: "fornaio", zone: "campagna_bassa", interval: 24, active_when: PopulationBelow(template: "fornaio", count: 4)),
        (id: "arrivi_agenti", template: "agente", zone: "stazione_polizia", interval: 24, active_when: PopulationBelow(template: "agente", count: 4)),
        (id: "arrivi_cronisti", template: "cronista", zone: "redazione", interval: 24, active_when: PopulationBelow(template: "cronista", count: 3)),
        (id: "arrivi_ubriaconi", template: "ubriacone", zone: "bar_ubriaconi", interval: 24, active_when: PopulationBelow(template: "ubriacone", count: 4)),
        (id: "arrivi_preti", template: "prete", zone: "cattedrale", interval: 48, active_when: PopulationBelow(template: "prete", count: 2)),
        (id: "arrivi_templari", template: "cavaliere_templare", zone: "borgo_templari", interval: 48, active_when: PopulationBelow(template: "cavaliere_templare", count: 2)),
        (id: "arrivi_boomer", template: "boomer", zone: "circolo_boomer", interval: 48, active_when: PopulationBelow(template: "boomer", count: 3)),
        (id: "arrivi_goth", template: "goth", zone: "piazza_garibaldi", interval: 48, active_when: PopulationBelow(template: "goth", count: 2)),
        (id: "arrivi_nerd", template: "nerd", zone: "fumetteria", interval: 48, active_when: PopulationBelow(template: "nerd", count: 2)),
        (id: "arrivi_mistici", template: "mistico_vegano", zone: "impero_vegano", interval: 48, active_when: PopulationBelow(template: "mistico_vegano", count: 2)),
        (id: "arrivi_croupier", template: "croupier", zone: "casino", interval: 48, active_when: PopulationBelow(template: "croupier", count: 2)),
        (id: "arrivi_minatori", template: "minatore", zone: "miniera", interval: 48, active_when: PopulationBelow(template: "minatore", count: 6)),
        (id: "arrivi_medici", template: "medico", zone: "cattedrale", interval: 72, active_when: PopulationBelow(template: "medico", count: 1)),
        (id: "arrivi_elfi", template: "elfo_logistica", zone: "capannone_regali", interval: 24, active_when: PopulationBelow(template: "elfo_logistica", count: 5),
         tether: (zone: "capannone_regali", release: Never)),
        (id: "dinosauri", template: "dinosauro", zone: "tana_dinosauri", interval: 24, max_alive: 2, summoner: "capo_dei_nani",
         faction: "nani_miniere", tether: (zone: "gallerie", release: Flag(flag: "gallerie_violate", min: 1))),
        (id: "robot_rotonde", template: "robot", zone: "rotonde", interval: 24, max_alive: 3, summoner: "boomer_overmind",
         faction: "circolo_boomer", tether: (zone: "rotonde", release: Flag(flag: "overmind_allerta", min: 1))),
        (id: "droni", template: "drone", zone: "circolo_boomer", interval: 36, max_alive: 2, summoner: "boomer_overmind",
         faction: "circolo_boomer", tether: (zone: "circolo_boomer", release: Flag(flag: "overmind_allerta", min: 1))),
        (id: "zombie", template: "zombie", zone: "cripta", interval: 12, max_alive: 4, summoner: "gran_custode",
         faction: "cripta_san_vitale", tether: (zone: "cripta", release: Flag(flag: "cripta_aperta", min: 1))),
        (id: "droidi", template: "droide_r2", zone: "fumetteria", interval: 48, max_alive: 1, faction: "gilda_nerd",
         tether: (zone: "fumetteria", release: BuildingHpBelow(building: "fumetteria", ratio: 0.8))),
        (id: "waifu", template: "waifu", zone: "fumetteria", interval: 48, max_alive: 1, faction: "gilda_nerd",
         tether: (zone: "fumetteria", release: BuildingHpBelow(building: "fumetteria", ratio: 0.8))),
        (id: "maid", template: "maid", zone: "fumetteria", interval: 72, max_alive: 1, faction: "gilda_nerd",
         tether: (zone: "fumetteria", release: BuildingHpBelow(building: "fumetteria", ratio: 0.8))),
        (id: "leoni", template: "leone", zone: "casino", interval: 48, max_alive: 2, summoner: "diablo", faction: "casino_diablo",
         tether: (zone: "casino", release: Flag(flag: "crediti_insoluti", min: 1))),
    ],
    triggers: [
        (id: "nani_scavano", name: "I Nani allargano la fortezza", repeat: true, cooldown: 6, when: TemplateAlive("capo_dei_nani"),
         effects: [Custom(id: "dig_frontier", params: {"zone": "#fortezza", "faction": "nani_miniere", "count": 4, "max_open": 14})]),
        (id: "oracolo_assegnazione", name: "L'Oracolo sceglie da che parte stare", when: TickAtLeast(0),
         effects: [Custom(id: "oracle_assign")]),
        (id: "oracolo_rivelazione", name: "L'Oracolo parla", repeat: true, cooldown: 96,
         when: All([TickAtLeast(12), TemplateAlive("oracolo")]), effects: [Custom(id: "oracle_reveal")]),
        (id: "gallerie_violate", name: "Intrusi nelle Gallerie dei Nani!", news: 0.7,
         when: Custom(id: "intruders", params: {"zone": "gallerie", "faction": "nani_miniere", "min": 1}),
         effects: [SetFlag(flag: "gallerie_violate", value: 1)]),
        (id: "overmind_allerta", name: "L'Overmind dichiara lo stato d'allerta", news: 0.8,
         when: Any([TickAtLeast(96), Custom(id: "intruders", params: {"zone": "circolo_boomer", "faction": "circolo_boomer", "min": 2})]),
         effects: [SetFlag(flag: "overmind_allerta", value: 1),
                   Publish(headline: "ALLERTA: l'Overmind attiva i robot delle rotonde. Restate in casa (e comprate gnomi).", truth: Propaganda, topics: ["bufala", "allerta"])]),
        (id: "cripta_aperta", name: "La Cripta di San Vitale si apre", news: 0.9, when: TickAtLeast(144),
         effects: [SetFlag(flag: "cripta_aperta", value: 1)]),
        (id: "crediti_insoluti", name: "Il Casinò esige i crediti", when: TickAtLeast(60),
         effects: [SetFlag(flag: "crediti_insoluti", value: 1)]),
        (id: "opera_del_borgazzi", name: "Il Borgazzi dipinge", repeat: true, cooldown: 48,
         when: All([TickAtLeast(10), TemplateAlive("gerolamo_borgazzi")]), effects: [Custom(id: "borgazzi_masterpiece")]),
        (id: "visita_presidenziale", name: "Visita del Presidente della Repubblica", news: 0.6, when: TickAtLeast(30),
         effects: [Spawn(template: "presidente_repubblica", count: 1, zone: "piazza_garibaldi"),
                   Publish(headline: "Il Presidente della Repubblica in visita a Fidenza: «Che bella rotonda»", truth: Real, topics: ["politica"])]),
        (id: "epidemia_terme", name: "Epidemia alle Terme di Salsomaggiore", news: 1.0, when: TickAtLeast(150),
         effects: [On(Zone("salsomaggiore_terme"), Chance(0.4, ApplyStatus(status: "diarrea"))),
                   Publish(headline: "Emergenza sanitaria alle Terme: chiuse le piscine, la Cripta nega ogni responsabilità", truth: Real, topics: ["epidemia", "salso"])]),
        (id: "re_morto", name: "Il Re è morto", news: 1.0, when: TemplateDead("re_anolino"),
         effects: [Publish(headline: "Re Anolino è morto! Il Trono degli Ubriaconi è vacante", truth: Real, topics: ["succession"])]),
    ],
    press: (
        feed_name: "Il Piccione Viaggiatore",
        default_headline: "{message}",
        headlines: {
            "arrest": ["Manette in Piazza: {actor} arresta {target}", "ARRESTATO {target}! Fidenza tira un sospiro di sollievo"],
            "crime": ["Fattaccio in pieno centro: {message}", "Paura a Fidenza: {message}"],
            "seizure": ["Maxi-sequestro: {message}"],
            "search": ["Perquisizione in piazza: {actor} fruga le tasche di {target}"],
            "bribe": ["Tangentopoli della Bassa: {faction} compra il silenzio della Polizia"],
            "exposed": ["CLAMOROSO: {message}"],
            "death": ["Lutto cittadino: {message}"],
            "mutilation": ["Sangue in strada: {message}"],
            "transmutation": ["Scienza o magia? {message}"],
            "pig_mutation": ["Emergenza porcina: {message}"],
            "succession": ["Viva il Re! {message}"],
            "succession_open": ["{message}"],
            "tether_released": ["Invasione! {message}"],
            "structure_damage": ["Crolli e disagi: {message}"],
            "collection_completed": ["Colpo grosso: {message}"],
        },
        publish_work: 2,
        important_threshold: 0.7,
        default_category: "varie",
        categories: [
            (id: "chiacchiere", name: "Chiacchiere", weight: 0.5,
             topics: ["bufala", "propaganda", "gossip", "oracolo"]),
            (id: "politica", name: "Politica", weight: 1.1,
             topics: ["succession", "succession_open", "politics", "alliance", "merge", "defection", "politica", "victory"]),
            (id: "cronaca", name: "Cronaca",
             topics: ["crime", "arrest", "seizure", "search", "bribe", "death", "mutilation", "exposed", "violence", "furto_sacrilego", "knocked_out"]),
            (id: "salute", name: "Salute",
             topics: ["epidemia", "pig_mutation", "transmutation", "infection", "contagion", "malattia"]),
            (id: "economia", name: "Economia",
             topics: ["economy", "unpaid", "structure_damage", "consequence", "collection_completed", "market", "shopping"]),
            (id: "eventi", name: "Eventi",
             topics: ["tether_released", "surface_raid", "allerta", "trigger", "masterpiece", "reliquia", "global"]),
        ],
    ),
    news_sources: [
        (id: "propaganda_chiesa", author: "vescovo", start_tick: 20, interval: 120, truth: Propaganda, headlines: [
            (headline: "Il Vescovo: «Chi custodisce la Testa di San Donnino custodisce Fidenza»", topics: ["propaganda", "chiesa"]),
            (headline: "Messa in piazza: offerte raddoppiate, peccati dimezzati", topics: ["propaganda", "chiesa"], effects: [ModTreasury(50)]),
        ]),
        (id: "propaganda_vegana", author: "gran_sacerdote_tofu", start_tick: 30, interval: 120, truth: Propaganda, headlines: [
            (headline: "Il Gran Sacerdote del Tofu: «La soia è l'unica reliquia che conta»", topics: ["propaganda", "vegano"]),
            (headline: "Studio indipendente (nostro): il culatello causa l'alopecia", topics: ["propaganda", "vegano", "carne"]),
        ]),
        (id: "propaganda_cda", author: "presidente_cda", start_tick: 40, interval: 144, truth: Propaganda, headlines: [
            (headline: "Fidenza Village: saldi del 70% su tutto, rettili esclusi", topics: ["propaganda", "shopping"]),
            (headline: "Il CdA smentisce: «Nessun rettiliano nel consiglio. Sssssì, nessuno»", topics: ["propaganda"]),
        ]),
        (id: "overmind_fake_news", author: "boomer_overmind", start_tick: 0, interval: 48, truth: Fake, headlines: [
            (headline: "I Vegani vogliono vietare il culatello: firmate la petizione!", topics: ["bufala", "vegano"]),
            (headline: "Gli Elfi della Logistica rubano il Wi-Fi ai pensionati", topics: ["bufala", "logistica"]),
            (headline: "5G nelle rotonde: ecco perché ti fa male la cervicale", topics: ["bufala"]),
            (headline: "Il Monolite di Soia emette radiazioni gender", topics: ["bufala", "vegano"]),
            (headline: "Si dice che i Salsesi mettano l'acqua nel Lambrusco", topics: ["bufala", "salso"],
             effects: [On(Template("salsese"), ModStat(stat: "morale", amount: -3))]),
        ]),
    ],
    news_impacts: [
        (topic: "epidemia", market: [("medicina", 1.8, 1.0), ("cibo", 1.2, 1.0)], duration: 72, morale: -2),
        (topic: "propaganda", morale: 1),
        (topic: "arrest", market: [("contrabbando", 1.6, 0.7), ("alcol", 1.2, 1.0)], duration: 48, subject_reputation: -10, relation: -5, morale: 1),
        (topic: "seizure", market: [("contrabbando", 1.3, 0.8)], duration: 48),
        (topic: "crime", market: [("lusso", 0.9, 1.0)], duration: 24, morale: -0.5),
        (topic: "bribe", subject_reputation: -15, relation: -10, morale: -1),
        (topic: "exposed", market: [("lusso", 0.7, 1.0)], duration: 72, subject_reputation: -30, morale: -1),
        (topic: "bufala", market: [("vegano", 0.8, 1.0)], duration: 24, morale: -0.3, fake_factor: 1.0),
        (topic: "pig_mutation", market: [("carne", 0.6, 1.2), ("medicina", 1.6, 1.0)], duration: 72, morale: -1),
        (topic: "death", morale: -0.5),
        (topic: "structure_damage", market: [("merce", 1.3, 0.9)], duration: 48),
        (topic: "succession", morale: 5),
    ],
    victory: [
        (id: "reliquie", name: "Il Corpo di San Donnino", primary: true, kind: HoldItems(["gamba_destra", "gamba_sinistra", "testa_san_donnino", "mano_destra", "mano_sinistra"]),
         description: "Riunire le cinque reliquie maggiori."),
        (id: "trono", name: "Il Trono degli Ubriaconi", kind: HoldTitle("trono_degli_ubriaconi"),
         description: "Mettere il proprio leader sul Trono degli Ubriaconi dopo la morte di Re Anolino."),
        (id: "punti", name: "Egemonia", kind: VictoryPoints(3000), description: "Accumulare 3000 punti vittoria."),
    ],
    sprites: {
        "race:fidentino": (shape: "circle", color: "#e8b98a", glyph: "F", sheet: "chibi_fidentino"),
        "race:salsese": (shape: "circle", color: "#d9a0a0", glyph: "S", sheet: "chibi_salsese"),
        "race:nano": (shape: "circle", color: "#b07040", glyph: "N", sheet: "chibi_nano"),
        "race:elfo_logistica": (shape: "circle", color: "#7fd18b", glyph: "E", sheet: "chibi_elfo_logistica"),
        "race:rettiliano": (shape: "diamond", color: "#4caf50", glyph: "R", sheet: "chibi_rettiliano"),
        "race:maiale": (shape: "circle", color: "#f4a6b8", glyph: "M", sheet: "chibi_maiale"),
        "race:dinosauro": (shape: "triangle", color: "#5d8a3a", glyph: "D", sheet: "chibi_dinosauro"),
        "race:robot": (shape: "square", color: "#9e9e9e", glyph: "R", sheet: "chibi_robot"),
        "race:drone": (shape: "triangle", color: "#607d8b", glyph: "d", sheet: "chibi_drone"),
        "race:zombie": (shape: "circle", color: "#8bc34a", glyph: "Z", sheet: "chibi_zombie"),
        "race:droide": (shape: "square", color: "#90caf9", glyph: "R2", sheet: "chibi_droide"),
        "race:androide": (shape: "circle", color: "#f8bbd0", glyph: "W", sheet: "chibi_androide"),
        "race:leone": (shape: "triangle", color: "#ffb300", glyph: "L", sheet: "chibi_leone"),
