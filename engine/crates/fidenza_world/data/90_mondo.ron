// Il mondo: giocatore, popolazione iniziale, dungeon, trigger, successione, stampa, vittoria, grafica.
(
    placements: [
        Player(id: "giocatore", name: "Giocatore", faction: "anarchici_commercio"),

        // Piazza Garibaldi: la scena della demo.
        Entity(template: "leader_anarchico", zone: "piazza_garibaldi", at: (31, 21), leader_of: "giocatore"),
        Entity(template: "scippatore", zone: "piazza_garibaldi", at: (36, 24), name: "Tommy lo Scippatore"),
        Entity(template: "commerciante_ricco", zone: "piazza_garibaldi", at: (37, 25), name: "Sior Ernesto"),
        Entity(template: "agente", zone: "piazza_garibaldi", at: (41, 27), name: "Agente Scelto Ferrari"),
        Entity(template: "cronista", zone: "piazza_garibaldi", at: (34, 21), name: "Lucia Taccuino"),
        Entity(template: "fidentino", count: 4, zone: "piazza_garibaldi"),
        Entity(template: "gerolamo_borgazzi", zone: "piazza_garibaldi", at: (43, 29)),
        Entity(template: "oracolo", zone: "piazza_garibaldi", at: (30, 29)),

        // Istituzioni e fazioni.
        Entity(template: "commissario", zone: "stazione_polizia"),
