        "race:cinghiale": (shape: "circle", color: "#6d4c33", glyph: "C", sheet: "chibi_cinghiale"),
        "class:poliziotto": (sheet: "acc_cap_polizia"),
        "class:cavaliere": (sheet: "acc_elmo"),
