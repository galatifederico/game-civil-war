// Status: alterazioni, droghe, malattie, mutazioni, poteri.
(
    statuses: [
        // Catena alcolica: Brillo -> Schifoso.
        (id: "brillo", name: "Brillo", kind: Intoxication, duration: 8, stacking: Intensify, tags: ["alcol"],
         description: "Un bicchiere di troppo.",
         stats: {"destrezza": -2, "resistenza": 1, "umore": 5}, escalates_to: "schifoso", escalate_at: 3),
        (id: "schifoso", name: "Schifoso", kind: Intoxication, duration: 12, tags: ["alcol"],
         description: "Perdita di destrezza, aumento di resistenza. Rischio di vomito.",
         stats: {"destrezza": -8, "resistenza": 5, "percezione": -5, "alcolismo": 2}, spills: ("vomito", 0.05),
         on_apply: [ModStat(stat: "alcolismo", amount: 1)]),
        // Sostanze: Fattone -> Super Luca.
        (id: "fattone", name: "Fattone", kind: Drug, duration: 8, stacking: Intensify, tags: ["droga"],
         description: "Aumenta la percezione e accelera i pensieri.",
         stats: {"percezione": 3, "velocita": -0.2}, ai_speed: 1.3, need_rates: {"fame": 1.0},
         escalates_to: "super_luca", escalate_at: 3),
        (id: "super_luca", name: "Super Luca", kind: Drug, duration: 10, tags: ["droga"],
         description: "Percezione sovrumana, Utility AI a doppia velocità.",
         stats: {"percezione": 10, "velocita": 1, "intelletto": 3}, ai_speed: 2.0),
        // Malattie.
        (id: "diarrea", name: "Diarrea", kind: Disease, duration: 24, tags: ["malattia"],
         description: "Si diffonde con liquami, acqua e cibo contaminati.", need_rates: {"fame": 1.5, "riposo": 0.5},
         stats: {"morale": -5}, spills: ("liquami", 0.1),
         contagion: (vectors: [Fluid, Water, Food], chance: 0.05, shedding: 0.05)),
        (id: "std", name: "STD", kind: Disease, hidden: true, tags: ["malattia"],
         description: "Malattia sessualmente trasmissibile, asintomatica finché non la si analizza.",
         stats: {"punti_gay": 1, "morale": -2}, contagion: (vectors: [Contact], chance: 0.01)),
        (id: "alopecia", name: "Alopecia", kind: Disease, progression: 0.02, tags: ["malattia"],
         description: "Perdita progressiva dei capelli.",
         stages: [
            (name: "Stempiatura", at: 1.0, stats: {"alopecia": 10}),
            (name: "Chierica", at: 2.0, stats: {"alopecia": 30, "alpha_status": -3}),
            (name: "Palla da biliardo", at: 3.0, stats: {"alopecia": 60, "alpha_status": -8}),
         ]),
        (id: "blue_balls", name: "Blue Balls", kind: Debuff, duration: 24, tags: ["malattia"],
         stats: {"morale": -10, "destrezza": -3}, need_rates: {"svago": 1.0}),
        (id: "carenza_b12", name: "Carenza da B12", kind: Debuff, progression: 0.01, tags: ["malattia", "vegano"],
         description: "Dieta di sola soia.", stats: {"forza": -3, "percezione": -2}),
        (id: "mutazione_porcina", name: "Mutazione Porcina", kind: Mutation, progression: 0.05, tags: ["mutazione"],
         description: "Trasformazione progressiva in maiale. Curabile con il Siero Anti-Porcino prima dell'ultimo stadio.",
         contagion: (vectors: [Injection], chance: 0.0),
         stages: [
            (name: "Grugnito", at: 1.0, stats: {"carisma": -3}),
            (name: "Codino", at: 2.0, stats: {"carisma": -6, "intelletto": -3}),
            (name: "Zampe", at: 3.0, stats: {"destrezza": -8}, on_enter: [Emit(kind: "pig_mutation", message: "{subject} sta diventando un maiale!", news: 0.8)]),
            (name: "Maiale", at: 4.0, on_enter: [Transmute("maiale"), RemoveStatus("mutazione_porcina")]),
         ]),
        (id: "morbo_san_vitale", name: "Morbo di San Vitale", kind: Disease, progression: 0.04, tags: ["malattia", "zombie"],
         description: "Il contagio della cripta: chi arriva in fondo si rialza zombie.",
         contagion: (vectors: [Contact, Fluid], chance: 0.1, shedding: 0.02), spills: ("melma_zombie", 0.02),
         stages: [
            (name: "Pallore", at: 1.0, stats: {"morale": -5}),
            (name: "Fame di cervelli", at: 2.0, need_rates: {"fame": 2.0}),
            (name: "Zombificazione", at: 3.0, on_enter: [Transmute("zombie"), RemoveStatus("morbo_san_vitale")]),
         ]),
        // Temporanei.
        (id: "avvelenato", name: "Avvelenato", kind: Debuff, duration: 6, per_tick: [Damage(amount: 1.5)], tags: ["veleno"]),
        (id: "stordito", name: "Stordito", kind: Debuff, duration: 3, stats: {"velocita": -1, "destrezza": -5}, ai_speed: 0.3),
        (id: "levitazione", name: "Levitazione", kind: Power, duration: 6, stats: {"velocita": 1.5, "furtivita": 5}),
        (id: "aura_di_formaggio", name: "Aura di formaggio", kind: Trait, duration: 24, grants_tags: ["aura_di_carne"],
         description: "Chi mangia salumi e formaggi emana un'aura che la Polizia Vegana riconosce."),
        (id: "in_sella", name: "In sella a un dinosauro", kind: Buff, duration: 24, stats: {"velocita": 1.5, "forza": 15, "alpha_status": 20},
         grants_tags: ["cavaliere_di_dinosauro"], on_expire: [Custom(id: "dismount")]),
        (id: "vaccinato", name: "Vaccinato", kind: Buff, duration: 240, tags: ["vaccino"]),
        (id: "benedetto", name: "Benedetto", kind: Buff, duration: 24, stats: {"morale": 10}),
    ],
)
