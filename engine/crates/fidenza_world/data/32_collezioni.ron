// Le tre grandi collezioni: le Opere del Borgazzi (pezzi unici, li dipinge lui e finiscono nella sua galleria),
// le Foto di Pag e i Santini (si trovano nelle bustine: chi ne apre una pesca un pezzo a caso).
// Ogni pezzo ha un effetto: le opere e le foto danno bonus a chi le porta addosso, metà dei santini si
// "usano" (una preghiera e via), l'altra metà protegge chi li tiene in tasca.
(
    items: [
        // ── Opere del Borgazzi (uniche) ──
        (id: "opera_borgazzi_1", name: "Il Lambrusco Cosmico", category: "arte", stack_max: 1, base_price: 500, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"mistica": 3, "umore": 2},
         description: "Una bottiglia di Lambrusco esplode in una galassia di bollicine. Il primo capolavoro del Borgazzi."),
        (id: "opera_borgazzi_2", name: "Autoritratto con Rotonda", category: "arte", stack_max: 1, base_price: 500, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"carisma": 3},
         description: "Il Borgazzi si ritrae al centro di una rotonda, mentre le auto gli girano intorno come pianeti."),
        (id: "opera_borgazzi_3", name: "Natura Morta con Salame", category: "arte", stack_max: 1, base_price: 500, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"umore": 3, "resistenza": 1},
         description: "Un salame, una mela e un coltello. Il salame non è sopravvissuto alla seduta di posa."),
        (id: "opera_borgazzi_4", name: "La Nebbia sulla Via Emilia", category: "arte", stack_max: 1, base_price: 450, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"furtivita": 4},
         description: "Una tela completamente grigia. I critici giurano che dentro ci sia un camion."),
        (id: "opera_borgazzi_5", name: "Il Duomo che Fuma", category: "arte", stack_max: 1, base_price: 650, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"mistica": 4},
         description: "Il Duomo di Fidenza con una sigaretta tra i campanili. La Chiesa ha chiesto di toglierla dalle mostre."),
        (id: "opera_borgazzi_6", name: "Ritratto del Sindaco in Ciabatte", category: "arte", stack_max: 1, base_price: 400, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"carisma": 2, "alpha_status": 2},
         description: "Fascia tricolore, sguardo fiero, ciabatte di gomma. Il potere visto da vicino."),
        (id: "opera_borgazzi_7", name: "La Ragazza col Culatello", category: "arte", stack_max: 1, base_price: 900, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"carisma": 4, "umore": 1},
         description: "Lo sguardo enigmatico, la fetta perfetta. La chiamano la Gioconda della Bassa."),
        (id: "opera_borgazzi_8", name: "Battaglia delle Rotonde", category: "arte", stack_max: 1, base_price: 550, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"forza": 2, "onore": 2},
         description: "Utilitarie e trattori si sfidano per la precedenza. Nessuno mette la freccia."),
        (id: "opera_borgazzi_9", name: "Il Grido del Parcheggiatore", category: "arte", stack_max: 1, base_price: 600, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"mistica": 5, "umore": -2},
         description: "Un uomo urla davanti a un parcheggio pieno. Il cielo è color disco orario."),
        (id: "opera_borgazzi_10", name: "San Donnino Decapitato (bozzetto)", category: "arte", stack_max: 1, base_price: 700, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi", "sacro"], carried_stats: {"onore": 4},
         description: "Il santo regge la propria testa con l'aria di chi ha appena perso il treno."),
        (id: "opera_borgazzi_11", name: "Le Terme di Salso al Tramonto", category: "arte", stack_max: 1, base_price: 500, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"resistenza": 3},
         description: "Vapori, accappatoi e un pensionato che galleggia. Rilassante solo a guardarlo."),
        (id: "opera_borgazzi_12", name: "Notte Stellata sul Fidenza Village", category: "arte", stack_max: 1, base_price: 650, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"intelletto": 3},
         description: "Le stelle vorticano sopra l'outlet. Una di loro ha il cartellino del 70%."),
        (id: "opera_borgazzi_13", name: "Il Bacio del Tortello", category: "arte", stack_max: 1, base_price: 550, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"umore": 4},
         description: "Due tortelli d'erbetta abbracciati in un mare di burro fuso. Commovente."),
        (id: "opera_borgazzi_14", name: "Nudo di Boomer con Panama", category: "arte", stack_max: 1, base_price: 350, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"alpha_status": 3, "carisma": -1},
         description: "Il Circolo dei Boomer l'ha commissionato. Il Circolo dei Boomer se ne è pentito."),
        (id: "opera_borgazzi_15", name: "La Persistenza del Parmigiano", category: "arte", stack_max: 1, base_price: 700, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"intelletto": 4},
         description: "Forme di grana che colano dai rami come orologi. Stagionato 36 mesi, come l'idea."),
        (id: "opera_borgazzi_16", name: "Il Quarto Stato della Bassa", category: "arte", stack_max: 1, base_price: 600, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"forza": 3, "onore": 1},
         description: "Contadini in marcia verso il consorzio agrario. Uno ha dimenticato il trattore acceso."),
        (id: "opera_borgazzi_17", name: "La Creazione del Gnocco Fritto", category: "arte", stack_max: 1, base_price: 650, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"mistica": 3, "umore": 1},
         description: "Un dito divino sfiora un gnocco fritto. Il gnocco si gonfia di vita."),
        (id: "opera_borgazzi_18", name: "L'Ultima Cena al Circolo", category: "arte", stack_max: 1, base_price: 800, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"onore": 3, "carisma": 1},
         description: "Tredici pensionati, una tavolata, un conto che nessuno vuole pagare."),
        (id: "opera_borgazzi_19", name: "Ninfee nello Stirone", category: "arte", stack_max: 1, base_price: 450, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"percezione": 3},
         description: "Ninfee, fossili e un cinghiale che fa il bagno. Impressionismo di torrente."),
        (id: "opera_borgazzi_20", name: "Il Pensatore al Bar Sport", category: "arte", stack_max: 1, base_price: 500, unique: true,
         tags: ["collezionabile", "arte", "opera_borgazzi"], carried_stats: {"intelletto": 2, "alcolismo": 2},
         description: "Mento sulla mano, gomito sul bancone, terzo bianchino. Sta pensando a cosa ordinare."),

        // ── Foto di Pag (nelle bustine della Fumetteria) ──
        (id: "foto_di_pag", name: "Zrće alle Quattro del Mattino", category: "foto", stack_max: 5, base_price: 8,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"alcolismo": 1, "umore": 2},
         description: "La spiaggia di Pag all'alba: nessuno in piedi, tutti felici."),
        (id: "foto_pag_02", name: "Il Boomer in Perizoma", category: "foto", stack_max: 5, base_price: 12,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"alpha_status": 2},
         description: "Il presidente del Circolo dei Boomer, ad agosto, in tutta la sua gloria. Non si può dimenticare."),
        (id: "foto_pag_03", name: "Selfie col Gommone Bucato", category: "foto", stack_max: 5, base_price: 6,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"umore": 1, "resistenza": 1},
         description: "Il gommone sta affondando. Il sorriso no."),
        (id: "foto_pag_04", name: "La Comitiva di Fidenza al Completo", category: "foto", stack_max: 5, base_price: 10,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"carisma": 2},
         description: "Ventidue fidentini su una panchina per sei. Qualcuno sta per cadere in mare."),
        (id: "foto_pag_05", name: "Il Tatuaggio Sbagliato", category: "foto", stack_max: 5, base_price: 9,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"onore": -1, "umore": 2},
         description: "«Fidenza per sempre», scritto con due errori. Sulla schiena."),
        (id: "foto_pag_06", name: "Tramonto con Bottiglia di Rakija", category: "foto", stack_max: 5, base_price: 7,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"alcolismo": 2, "mistica": 1},
         description: "Il sole cala nell'Adriatico. La rakija cala nello stomaco."),
        (id: "foto_pag_07", name: "Il Nerd che Scopre il Sole", category: "foto", stack_max: 5, base_price: 11,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"intelletto": 1, "resistenza": 1},
         description: "Primo contatto con la luce naturale dopo tre anni di fumetteria. Ustione di secondo grado."),
        (id: "foto_pag_08", name: "La Coda per il Traghetto", category: "foto", stack_max: 5, base_price: 6,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"resistenza": 2},
         description: "Sei ore sotto il sole per salire su una barca. Una lezione di pazienza."),
        (id: "foto_pag_09", name: "Il Prete in Infradito", category: "foto", stack_max: 5, base_price: 14,
         tags: ["collezionabile", "foto_pag", "sacro"], carried_stats: {"mistica": 2, "umore": 1},
         description: "Anche il clero va in vacanza. La tonaca resta a Fidenza."),
        (id: "foto_pag_10", name: "Schiuma Party al Papaya", category: "foto", stack_max: 5, base_price: 9,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"umore": 3, "percezione": -1},
         description: "Una montagna di schiuma con dentro, forse, tre fidentini e un salsese."),
        (id: "foto_pag_11", name: "Il Nano sulla Sdraio", category: "foto", stack_max: 5, base_price: 10,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"forza": 1, "umore": 1},
         description: "Un nano delle miniere vede il mare per la prima volta. Vuole scavarci dentro."),
        (id: "foto_pag_12", name: "Ricordo dal Pullman delle Due di Notte", category: "foto", stack_max: 5, base_price: 7,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"resistenza": 1, "umore": 1},
         description: "Tutti addormentati, l'autista no. Speriamo."),
        (id: "foto_pag_13", name: "Il Rettiliano che Prende il Sole", category: "foto", stack_max: 5, base_price: 15,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"percezione": 2},
         description: "Immobile su uno scoglio per sei ore. Sospetto. Molto sospetto."),
        (id: "foto_pag_14", name: "Ballo di Gruppo sul Molo", category: "foto", stack_max: 5, base_price: 8,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"destrezza": 2},
         description: "La Macarena di Pag: quaranta persone, quaranta coreografie diverse."),
        (id: "foto_pag_15", name: "Il Formaggio di Pag contro il Grana", category: "foto", stack_max: 5, base_price: 9,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"onore": 2},
         description: "Sfida all'ultimo assaggio. Il grana ha vinto, ma solo ai punti."),
        (id: "foto_pag_16", name: "Gli Occhiali da Sole Persi in Mare", category: "foto", stack_max: 5, base_price: 6,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"percezione": -1, "umore": 2},
         description: "Ultima foto prima dell'onda. Gli occhiali sono ancora là sotto."),
        (id: "foto_pag_17", name: "Lo Sciopero del Bagnino", category: "foto", stack_max: 5, base_price: 10,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"vandalismo": 1, "forza": 1},
         description: "Il bagnino incrocia le braccia. I turisti incrociano le dita."),
        (id: "foto_pag_18", name: "Il Primo Bacio Sotto il Faro", category: "foto", stack_max: 5, base_price: 13,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"carisma": 2, "umore": 1},
         description: "Romantico, finché non è arrivato il fanalino della Guardia Costiera."),
        (id: "foto_pag_19", name: "La Scottatura a Forma di Canotta", category: "foto", stack_max: 5, base_price: 7,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"resistenza": -1, "umore": 2},
         description: "Rosso fuoco con una canotta bianca disegnata sopra. Arte contemporanea."),
        (id: "foto_pag_20", name: "Il Ritorno a Fidenza", category: "foto", stack_max: 5, base_price: 12,
         tags: ["collezionabile", "foto_pag"], carried_stats: {"umore": -1, "onore": 2},
         description: "La nebbia, la rotonda, il lunedì. Si torna a casa."),

        // ── Santini: santi veri, con effetti presi dalla loro storia, dal martirio e dai simboli (bustine al Banchetto dei Santini) ──
        (id: "santino", name: "San Donnino", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"onore": 2, "resistenza": 1},
         description: "Patrono di Fidenza. Decapitato sul ponte dello Stirone nel 304, raccolse la propria testa e la portò fino al luogo dove oggi sorge il Duomo. Chi lo tiene in tasca non perde la testa (né l'onore)."),
        (id: "santino_02", name: "Sant'Onofrio", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], on_use: [ModStat(stat: "fame", amount: 40), ModStat(stat: "riposo", amount: 20)],
         description: "Eremita nel deserto d'Egitto per sessant'anni, coperto solo dalla barba e dai capelli; un angelo gli portava il pane ogni giorno. Pregandolo arriva il pane, e un po' di pace."),
        (id: "santino_03", name: "San Giuda Taddeo", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], on_use: [ModStat(stat: "morale", amount: 12)],
         description: "Apostolo, ucciso a colpi di scure o di clava in Persia; si raffigura con la fiamma sulla testa e il medaglione col volto di Cristo. È il patrono delle cause disperate: ridà coraggio a chi l'ha perso."),
        (id: "santino_04", name: "Sant'Antonio Abate", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], on_use: [RemoveStatus("mutazione_porcina")],
         description: "Eremita del deserto, tentato dai demoni; ha sempre accanto il maialino e il fuoco. Protettore degli animali domestici: chi sta diventando un maiale lo prega e torna umano."),
        (id: "santino_05", name: "San Lorenzo", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"resistenza": 3},
         description: "Diacono di Roma, arso vivo su una graticola nel 258 («Giratemi, da questa parte sono cotto»). Patrono dei cuochi e di chi sopporta il calore: chi lo porta resiste a tutto. Le sue lacrime cadono il 10 agosto."),
        (id: "santino_06", name: "San Sebastiano", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], on_use: [Immunize(status: "morbo_san_vitale", ticks: 72)],
         description: "Soldato romano trafitto dalle frecce, sopravvissuto e poi ucciso a bastonate. Invocato contro la peste, perché le frecce erano il simbolo del contagio: protegge per tre giorni dal Morbo di San Vitale."),
        (id: "santino_07", name: "Santa Lucia", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"percezione": 3},
         description: "Martire di Siracusa, si raffigura con gli occhi su un piatto. Protettrice della vista: chi la tiene in tasca vede ciò che gli altri non vedono."),
        (id: "santino_08", name: "Sant'Agata", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], on_use: [Heal(20)],
         description: "Martire di Catania, torturata e mutilata, guarita in carcere da San Pietro apparso in visione. Patrona delle infermiere: pregarla risana le ferite."),
        (id: "santino_09", name: "San Biagio", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], on_use: [Immunize(status: "avvelenato", ticks: 48)],
         description: "Vescovo e medico armeno, salvò un bambino con una lisca di pesce in gola; si benedice la gola con due candele incrociate. Protegge per due giorni da ciò che si manda giù di velenoso."),
        (id: "santino_10", name: "Santa Apollonia", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"carisma": 2},
         description: "Vergine di Alessandria a cui strapparono i denti prima del rogo; si raffigura con la tenaglia. Patrona dei dentisti: chi la porta sorride meglio."),
        (id: "santino_11", name: "San Rocco", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], on_use: [RemoveStatus("morbo_san_vitale")],
         description: "Pellegrino di Montpellier che curava gli appestati e si ammalò a sua volta; un cane gli portava il pane e mostra la piaga sulla gamba. Guarisce dal Morbo di San Vitale."),
        (id: "santino_12", name: "San Cristoforo", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"velocita": 0.15},
         description: "Il gigante che portò Gesù bambino attraverso un fiume in piena, sentendo sulle spalle il peso del mondo. Patrono dei viaggiatori e degli automobilisti: chi lo porta cammina più svelto (e guada lo Stirone)."),
        (id: "santino_13", name: "Santa Rita da Cascia", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], on_use: [ApplyStatus(status: "benedetto")],
         description: "Moglie, madre, vedova e monaca, con la spina della corona di Cristo conficcata nella fronte; le rose fiorirono per lei in pieno inverno. La santa degli impossibili: la sua preghiera benedice."),
        (id: "santino_14", name: "San Francesco d'Assisi", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], on_use: [ModMoney(-10), ModStat(stat: "onore", amount: 6), ModStat(stat: "umore", amount: 4)],
         description: "Figlio di un ricco mercante, si spogliò di tutto davanti al vescovo; parlava agli uccelli e ricevette le stimmate. Pregarlo costa: dieci euro ai poveri, in cambio di onore e serenità."),
        (id: "santino_15", name: "San Giorgio", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"forza": 2, "eroismo": 3},
         description: "Cavaliere della Cappadocia che uccise il drago per salvare la principessa, poi martire sotto Diocleziano. Chi lo porta combatte da eroe (i dinosauri dello Stirone sono avvisati)."),
        (id: "santino_16", name: "San Pietro", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"furtivita": 2, "destrezza": 1},
         description: "Il pescatore delle chiavi del Regno, crocifisso a testa in giù. Rinnegò tre volte prima del canto del gallo: chi lo porta sa negare tutto e aprire qualunque porta."),
        (id: "santino_17", name: "San Paolo", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"intelletto": 2, "carisma": 1},
         description: "Caduto da cavallo sulla via di Damasco, autore delle Lettere, decapitato con la spada a Roma. Chi lo porta parla e scrive come un apostolo."),
        (id: "santino_18", name: "Santa Barbara", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"resistenza": 2, "forza": 1},
         description: "Rinchiusa dal padre in una torre a tre finestre e da lui decapitata; il padre fu subito incenerito da un fulmine. Patrona dei minatori, degli artificieri e dei vigili del fuoco: i Nani la venerano."),
        (id: "santino_19", name: "San Bartolomeo", category: "santino", stack_max: 10, base_price: 1,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"forza": 2, "carisma": -1},
         description: "Apostolo scorticato vivo in Armenia, si raffigura con la propria pelle sul braccio e il coltello. Patrono dei macellai e dei conciatori della Bassa: dà la forza di chi lavora la carne, non la bellezza."),
        (id: "santino_20", name: "San Giuseppe", category: "santino", stack_max: 10, base_price: 2,
         tags: ["collezionabile", "santino", "sacro"], carried_stats: {"destrezza": 2}, on_use: [ModStat(stat: "riposo", amount: 30)],
         description: "Il falegname di Nazareth, col giglio fiorito e gli attrezzi; patrono dei lavoratori e della buona morte. In tasca dà mani da artigiano, pregato dà un sonno tranquillo."),

        // ── Bustine: si comprano e si aprono subito, dentro c'è un pezzo a caso ──
        (id: "bustina_santini", name: "Bustina di santini", category: "bustina", stack_max: 5, base_price: 2,
         tags: ["bustina"], on_use: [GiveRandomItem(tag: "santino")],
         description: "Una bustina sigillata con un santino a sorpresa."),
        (id: "bustina_foto_pag", name: "Bustina di foto di Pag", category: "bustina", stack_max: 5, base_price: 8,
         tags: ["bustina"], on_use: [GiveRandomItem(tag: "foto_pag")],
         description: "Una foto a caso dalle vacanze di Fidenza a Pag. Rischio imbarazzo alto."),
    ],
    collections: [
        (id: "opere_borgazzi", name: "Opere del Borgazzi", per_faction: true, victory_points: 300,
