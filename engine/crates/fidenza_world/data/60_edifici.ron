        (id: "laboratorio_fake_meat", name: "Laboratorio Fake Meat", footprint: (3, 3), hp: 80, exports: ["fake_meat"], tags: ["produzione", "negozio", "vegano"], sells: {"fake_meat": None}, stock: {"fake_meat": 4},
         productions: [(id: "fake", name: "Sintetizza Fake Meat", inputs: {"soia": 3}, outputs: {"fake_meat": 2}, work: 4, work_type: "produzione")]),
        (id: "fucina", name: "Fucina", footprint: (3, 3), hp: 120, exports: ["katana", "shuriken", "spada", "spadone", "elmo", "armatura_templare"], tags: ["produzione"],
