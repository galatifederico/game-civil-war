         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 120)]),
        (id: "sala_giochi", name: "Sala da gioco del Casinò", footprint: (3, 4), hp: 200, tags: ["vizio", "turismo"],
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 150)]),
        (id: "deposito", name: "Deposito di pietra e minerali", footprint: (3, 2), hp: 200, tags: ["deposito"], stockpile: true,
         exports: ["pietra", "ferro", "sale", "gemma_sale_rosa", "oro_dei_nani"],
         description: "Dove i minatori portano quello che scavano; i mercanti lo comprano e lo portano in superficie."),
        (id: "fungaia_porcini", name: "Fungaia di porcini giganti", hp: 50, tags: ["fungaia", "campo"],
         productions: [(id: "produzione", name: "Produzione", every: 12, outputs: {"porcino_gigante": 3})]),
        (id: "scrigno_antico", name: "Scrigno degli antichi Nani", footprint: (1, 1), hp: 300, tags: ["cassaforte"],
         stock: {"oro_dei_nani": 5, "fossile_osso_dinosauro": 1}),
        (id: "acquedotto", name: "Serbatoio dell'acquedotto", footprint: (1, 2), hp: 200, tags: ["acqua", "infrastruttura"]),
    ],
    global_modifiers: [
        (id: "ritardo_regali", name: "Ritardi nelle consegne dei regali", per_tick: -1.389, stats: {"morale": -8}, prices: {"regalo": 1.8, "merce": 1.3}, logistics_disruption: 0.4),
        (id: "natale_cancellato", name: "Natale d'Agosto cancellato", per_tick: -0.595, stats: {"morale": -20}, prices: {"regalo": 3.0, "lusso": 1.5}, logistics_disruption: 0.8),
        (id: "proibizionismo", name: "Proibizionismo vegano", stats: {"morale": -5}, prices: {"alcol": 2.0, "carne": 1.5}, supply: {"alcol": 0.3, "carne": 0.5}, logistics_disruption: 0.1),
    ],
)
