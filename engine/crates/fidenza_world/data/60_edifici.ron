// Edifici: campi e allevamenti, catene di trasformazione, negozi, infrastrutture speciali.
(
    buildings: [
        // Campi e allevamenti (produzione passiva, accelerata da agricoltori e allevatori).
        (id: "vigna", name: "Vigna", hp: 60, tags: ["campo"], passive: {"uva": 2}, passive_interval: 8),
        (id: "luppoleto", name: "Luppoleto", hp: 60, tags: ["campo"], passive: {"luppolo": 2}, passive_interval: 8),
        (id: "campo_orzo", name: "Campo d'orzo", hp: 60, tags: ["campo"], passive: {"orzo": 2}, passive_interval: 8),
        (id: "campo_grano", name: "Campo di grano", hp: 60, tags: ["campo"], passive: {"grano": 4}, passive_interval: 8),
        (id: "orto", name: "Orto", hp: 40, tags: ["campo"], passive: {"ortaggi": 3}, passive_interval: 8),
        (id: "campo_soia", name: "Campo di soia", hp: 60, tags: ["campo", "vegano"], passive: {"soia": 3}, passive_interval: 8),
        (id: "porcilaia", name: "Porcilaia", hp: 80, tags: ["porcilaia"], passive: {"maiale_vivo": 1}, passive_interval: 24),
        (id: "cattedrale_idroponica", name: "Cattedrale Idroponica", hp: 150, tags: ["campo", "vegano"],
         passive: {"ortaggi": 3, "soia": 3}, passive_interval: 8),
        (id: "monolite_soia", name: "Monolite di Soia", hp: 400, tags: ["vegano", "sacro"], passive: {"soia": 5}, passive_interval: 24,
         consequences: [(below: 0.5, name: "Il Monolite si incrina", effects: [On(Everyone, If(MemberOf("impero_vegano"), ModStat(stat: "morale", amount: -20)))])]),
        // Catene di trasformazione.
        (id: "mulino", name: "Mulino", hp: 100, tags: ["produzione"],
         recipes: [(id: "macina", name: "Macina il grano", inputs: {"grano": 2}, outputs: {"farina": 3}, work: 3, work_type: "produzione")]),
        (id: "forno", name: "Forno / Panificio", hp: 100, tags: ["produzione", "negozio"], sells: {"pane": None}, markup: 1.1,
         stock: {"pane": 10},
         recipes: [(id: "panifica", name: "Sforna il pane", inputs: {"farina": 1}, outputs: {"pane": 4}, work: 3, work_type: "produzione")]),
        (id: "cantina", name: "Cantina", hp: 100, tags: ["produzione", "negozio"], sells: {"vino": None}, markup: 1.2, stock: {"vino": 6},
         recipes: [(id: "vinifica", name: "Vinifica", inputs: {"uva": 3}, outputs: {"vino": 2}, work: 5, work_type: "produzione")]),
        (id: "birrificio", name: "Birrificio", hp: 100, tags: ["produzione"],
         recipes: [(id: "birra", name: "Produce birra", inputs: {"luppolo": 1, "orzo": 2}, outputs: {"birra": 3}, work: 5, work_type: "produzione")]),
        (id: "distilleria", name: "Distilleria", hp: 100, tags: ["produzione"],
         recipes: [(id: "distilla", name: "Distilla grappa", inputs: {"uva": 4}, outputs: {"grappa": 1}, work: 6, work_type: "produzione")]),
        (id: "macello", name: "Macello", hp: 100, tags: ["produzione"],
         recipes: [(id: "macella", name: "Macella", inputs: {"maiale_vivo": 1}, outputs: {"carne": 4}, work: 4, work_type: "macelleria")]),
        (id: "salumificio", name: "Salumificio", hp: 100, tags: ["produzione", "negozio"], sells: {"salumi": None, "carne": None}, markup: 1.2,
         stock: {"salumi": 6, "carne": 4},
         recipes: [(id: "insacca", name: "Insacca", inputs: {"carne": 2}, outputs: {"salumi": 3}, work: 5, work_type: "macelleria")]),
        (id: "bar_estratti", name: "Bar di Estratti", hp: 60, tags: ["produzione", "negozio", "vegano"], sells: {"estratto_soia": None}, stock: {"estratto_soia": 6},
         recipes: [(id: "estrai", name: "Centrifuga la soia", inputs: {"soia": 2}, outputs: {"estratto_soia": 2}, work: 2, work_type: "produzione")]),
        (id: "laboratorio_fake_meat", name: "Laboratorio Fake Meat", hp: 80, tags: ["produzione", "negozio", "vegano"], sells: {"fake_meat": None}, stock: {"fake_meat": 4},
         recipes: [(id: "fake", name: "Sintetizza Fake Meat", inputs: {"soia": 3}, outputs: {"fake_meat": 2}, work: 4, work_type: "produzione")]),
        (id: "fucina", name: "Fucina", hp: 120, tags: ["produzione"],
         recipes: [
            (id: "katana", name: "Forgia katana", inputs: {"ferro": 3}, outputs: {"katana": 1}, work: 8, work_type: "forgia"),
            (id: "manganelli", name: "Forgia manganelli", inputs: {"ferro": 1}, outputs: {"manganello": 2}, work: 3, work_type: "forgia"),
            (id: "shuriken", name: "Forgia shuriken", inputs: {"ferro": 1}, outputs: {"shuriken": 4}, work: 3, work_type: "forgia"),
         ]),
        (id: "laboratorio_medico", name: "Laboratorio Medico", hp: 80, tags: ["medicina", "negozio"],
         sells: {"antidoto": None, "tachipirina": None, "vaccino_porcino": None}, stock: {"antidoto": 3, "tachipirina": 10}),
        // Negozi e luoghi di ritrovo.
        (id: "bar_ubriaconi", name: "Bar degli Ubriaconi", hp: 80, tags: ["negozio", "bar"],
         sells: {"birra": None, "vino": None, "grappa": None}, markup: 1.3, stock: {"birra": 30, "vino": 15, "grappa": 8}),
        (id: "outlet", name: "Outlet del Fidenza Village", hp: 300, tags: ["negozio", "lusso"],
         sells: {"salumi": None, "pc_smart_working": None, "macchina_fotografica": None, "trattore": None, "preservativo": None, "regalo_di_natale": None},
         markup: 1.5, stock: {"salumi": 10, "pc_smart_working": 3, "macchina_fotografica": 2, "trattore": 1, "preservativo": 20}),
        (id: "banco_mercato", name: "Banco del mercato", hp: 30, tags: ["negozio"], sells: {"pane": None, "ortaggi": None, "birra": None},
         stock: {"pane": 20, "ortaggi": 15, "birra": 15}),
        (id: "spacciatore_casino", name: "Retrobottega del Casinò", hp: 50, tags: ["negozio", "illegale"],
         sells: {"canna": None, "droga_sintetica": None, "petardo": None, "siero_mutageno": None}, markup: 1.5,
         stock: {"canna": 12, "droga_sintetica": 6, "petardo": 20, "siero_mutageno": 2}),
        (id: "fumetteria", name: "Fumetteria", hp: 80, tags: ["negozio", "nerd"], sells: {"foto_di_pag": None, "shuriken": None}, stock: {"foto_di_pag": 10, "shuriken": 10}),
        (id: "mensa_poveri", name: "Mensa dei Poveri", hp: 80, tags: ["negozio", "chiesa", "carita"],
         sells: {"pane": Some(0.0), "ortaggi": Some(0.0)}, stock: {"pane": 10, "ortaggi": 5},
         description: "La Chiesa sfama gratis chi non ha un euro (e paga il pane all'ingrosso)."),
        (id: "banchetto_santini", name: "Banchetto dei Santini", hp: 20, tags: ["negozio", "chiesa"], sells: {"santino": Some(1.0)}, stock: {"santino": 50}),
        // Infrastrutture speciali.
        (id: "stazione_polizia", name: "Stazione di Polizia con Celle", hp: 300, tags: ["celle", "polizia"]),
        (id: "redazione", name: "Redazione Giornalistica", hp: 80, tags: ["stampa"]),
        (id: "capannone_regali", name: "Capannone Logistico Regali", hp: 250, tags: ["logistica"],
         passive: {"giocattolo": 4}, passive_interval: 12,
         recipes: [(id: "impacchetta", name: "Impacchetta regali", inputs: {"giocattolo": 2}, outputs: {"regalo_di_natale": 2}, work: 2, work_type: "logistica")],
         consequences: [
            (below: 0.7, name: "Ritardi nelle consegne dei regali",
             effects: [GlobalModifier(id: "ritardo_regali", duration: 72)]),
            (below: 0.3, name: "Il Natale d'Agosto è cancellato",
             effects: [GlobalModifier(id: "natale_cancellato", duration: 168), SetFlag(flag: "natale_cancellato", value: 1)]),
         ]),
        (id: "gnomo_da_giardino", name: "Gnomo da Giardino", hp: 10, tags: ["gnomo", "telecamera"], vision: 6,
         description: "Mini-computer spia dei Boomer: rimuove la nebbia di guerra."),
        (id: "casseforti_cda", name: "Casseforti del CdA", hp: 500, tags: ["cassaforte"], stock: {"mano_destra": 1}),
        (id: "altare_cripta", name: "Altare della Cripta di San Vitale", hp: 200, tags: ["cripta"], stock: {"gamba_sinistra": 1}),
        (id: "trono_ubriaconi", name: "Trono degli Ubriaconi", hp: 999, tags: ["trono"]),
        (id: "cattedrale", name: "Cattedrale di San Donnino", hp: 600, tags: ["chiesa", "sacro"], stock: {"santino": 20}),
        (id: "acquedotto", name: "Serbatoio dell'acquedotto", hp: 200, tags: ["acqua", "infrastruttura"]),
    ],
    global_modifiers: [
        (id: "ritardo_regali", name: "Ritardi nelle consegne dei regali", logistics_disruption: 0.4, morale: -8,
         price_tags: [("regalo", 1.8), ("merce", 1.3)]),
        (id: "natale_cancellato", name: "Natale d'Agosto cancellato", logistics_disruption: 0.8, morale: -20,
         price_tags: [("regalo", 3.0), ("lusso", 1.5)]),
        (id: "proibizionismo", name: "Proibizionismo vegano", logistics_disruption: 0.1, morale: -5, price_tags: [("alcol", 2.0), ("carne", 1.5)]),
    ],
)
