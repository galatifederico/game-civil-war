         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 25)]),
        (id: "mensa_poveri", name: "Mensa dei Poveri", footprint: (3, 3), hp: 80, tags: ["negozio", "chiesa", "carita"],
         sells: {"pane": Some(0.0), "ortaggi": Some(0.0)}, stock: {"pane": 10, "ortaggi": 5},
         description: "La Chiesa sfama gratis chi non ha un euro (e paga il pane all'ingrosso)."),
        (id: "banchetto_santini", name: "Banchetto dei Santini", hp: 20, tags: ["negozio", "chiesa"], sells: {"santino": Some(1.0), "bustina_santini": Some(2.0)}, stock: {"santino": 20, "bustina_santini": 40}),
        // Infrastrutture speciali.
        (id: "stazione_polizia", name: "Stazione di Polizia con Celle", footprint: (3, 3), hp: 300, tags: ["celle", "polizia"],
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 30)]),
        (id: "redazione", name: "Redazione Giornalistica", footprint: (3, 3), hp: 80, tags: ["stampa"],
         productions: [(id: "visitatori", name: "Visitatori", every: 24, money: 30)]),
        (id: "capannone_regali", name: "Capannone Logistico Regali", footprint: (3, 4), hp: 250, exports: ["regalo_di_natale"], tags: ["logistica"],
         consequences: [
            (below: 0.7, name: "Ritardi nelle consegne dei regali",
             effects: [GlobalModifier(id: "ritardo_regali")]),
            (below: 0.3, name: "Il Natale d'Agosto è cancellato",
             effects: [GlobalModifier(id: "natale_cancellato"), SetFlag(flag: "natale_cancellato", value: 1)]),
         ],
         productions: [(id: "impacchetta", name: "Impacchetta regali", inputs: {"giocattolo": 2}, outputs: {"regalo_di_natale": 2}, work: 2, work_type: "logistica"), (id: "produzione", name: "Produzione", every: 12, outputs: {"giocattolo": 4})]),
        (id: "gnomo_da_giardino", name: "Gnomo da Giardino", hp: 10, tags: ["gnomo", "telecamera"], vision: 6,
         description: "Mini-computer spia dei Boomer: rimuove la nebbia di guerra."),
        (id: "casseforti_cda", name: "Casseforti del CdA", footprint: (3, 2), hp: 500, tags: ["cassaforte"], stock: {"mano_destra": 1}),
