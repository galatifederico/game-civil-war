// Edifici: campi e allevamenti, catene di trasformazione, negozi, infrastrutture speciali.
(
    buildings: [
        // Campi e allevamenti (produzione passiva, accelerata da agricoltori e allevatori).
        (id: "vigna", name: "Vigna", hp: 60, tags: ["campo"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"uva": 2})]),
        (id: "luppoleto", name: "Luppoleto", hp: 60, tags: ["campo"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"luppolo": 2})]),
        (id: "campo_orzo", name: "Campo d'orzo", hp: 60, tags: ["campo"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"orzo": 2})]),
        (id: "campo_grano", name: "Campo di grano", hp: 60, tags: ["campo"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"grano": 6})]),
        (id: "orto", name: "Orto", hp: 40, tags: ["campo"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"ortaggi": 4})]),
        (id: "campo_soia", name: "Campo di soia", hp: 60, tags: ["campo", "vegano"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"soia": 3})]),
        (id: "porcilaia", name: "Porcilaia", footprint: (3, 2), hp: 80, tags: ["porcilaia"],
         productions: [(id: "produzione", name: "Produzione", every: 24, outputs: {"maiale_vivo": 1})]),
        (id: "cattedrale_idroponica", name: "Cattedrale Idroponica", footprint: (3, 3), hp: 150, tags: ["campo", "vegano"],
         productions: [(id: "produzione", name: "Produzione", every: 8, outputs: {"ortaggi": 3, "soia": 3})]),
        (id: "monolite_soia", name: "Monolite di Soia", footprint: (1, 3), hp: 400, tags: ["vegano", "sacro"],
         consequences: [(below: 0.5, name: "Il Monolite si incrina", effects: [On(Everyone, If(MemberOf("impero_vegano"), ModStat(stat: "morale", amount: -20)))])],
         productions: [(id: "produzione", name: "Produzione", every: 24, outputs: {"soia": 5}), (id: "visitatori", name: "Visitatori", every: 24, money: 30)]),
        // Catene di trasformazione.
        (id: "mulino", name: "Mulino", footprint: (3, 3), hp: 100, tags: ["produzione"],
         productions: [(id: "macina", name: "Macina il grano", inputs: {"grano": 2}, outputs: {"farina": 3}, work: 3, work_type: "produzione")]),
        (id: "forno", name: "Forno / Panificio", footprint: (3, 3), hp: 100, tags: ["produzione", "negozio"], sells: {"pane": None}, markup: 1.1,
         stock: {"pane": 10},
         productions: [(id: "panifica", name: "Sforna il pane", inputs: {"farina": 1}, outputs: {"pane": 5}, work: 3, work_type: "produzione")]),
        (id: "cantina", name: "Cantina", footprint: (3, 3), hp: 100, exports: ["vino"], tags: ["produzione", "negozio"], sells: {"vino": None}, markup: 1.2, stock: {"vino": 6},
         productions: [(id: "vinifica", name: "Vinifica", inputs: {"uva": 3}, outputs: {"vino": 2}, work: 5, work_type: "produzione")]),
        (id: "birrificio", name: "Birrificio", footprint: (3, 3), hp: 100, exports: ["birra"], tags: ["produzione"],
