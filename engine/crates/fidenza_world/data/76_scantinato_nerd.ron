        ]),
    ],
    races: [
        (id: "polipo", name: "Polipo", body_plan: "cefalopode", action_sets: ["istinti_animali"], sexes: [], tags: ["polipo", "bestia", "fauna", "nerd"],
         needs_exempt: ["fame", "riposo", "svago", "sete"],
         description: "Vive nello Scantinato della Fumetteria da quando qualcuno ci ha buttato un acquario. Ha gusti precisi: punta le donne.",
         stat_ranges: {"forza": (initial: 26), "furtivita": (initial: 12), "percezione": (initial: 18), "attacco": (initial: 50), "difesa": (initial: 35)},
         immunities: ["diarrea", "std"], actions: ["avvinghia_donna", "avvinghia_chiunque", "nube_d_inchiostro"]),
    ],
    statuses: [
        (id: "avvinghiato", name: "Avvinghiato", description: "Stretto dai tentacoli: non scappa e si muove a fatica.", tags: ["presa", "penalità"], per_tick: -33.333, stats: {"velocita": -1, "destrezza": -5, "stress": 10}),
    ],
    actions: [
        (id: "scendi_nello_scantinato", name: "Scende nello Scantinato", weight: 0.1, cooldown: 120,
         requires: StatAtLeast(stat: "con_lore_nerd", value: 40),
         kind: Job(job: "scendi_nello_scantinato", target: Zone("scantinato_nerd")),
         considerations: [(input: Stat(stat: "curiosita", max: 100), curve: Identity)], label: "Scende nello Scantinato della Fumetteria", tags: ["esplorazione", "svago"],
         how: Some((duration: 3, effects: [ModStat(stat: "con_lore_nerd", amount: 1), ModStat(stat: "curiosita", amount: 0.5), ModStat(stat: "svago", amount: 20),
                   Chance(0.05, GiveRandomItem(items: ["costume_cosplay", "cerchietto_orecchie", "corazza_cartone"]))]))),
        // Prima le donne: peso alto e raggio più ampio.
        (id: "avvinghia_donna", name: "Avvinghia", weight: 2.5,
         kind: Effects(target: Nearest((pawn: true, visible: true, max_distance: 10, not_detained: true, tags_none: ["bestia", "macchina"],
                                                                condition: IsSex(Female))), range: 2, effects: [On(Target, All([Damage(amount: 5), ApplyStatus(status: "avvinghiato")]))]), cooldown: 4, description: "Avvinghia la vittima: danni e non scappa.", tags: ["violenza"]),
        (id: "avvinghia_chiunque", name: "Avvinghia", weight: 1.0,
         kind: Effects(target: Nearest((pawn: true, relation: Hostile, visible: true, max_distance: 3, tags_none: ["bestia"])), range: 2, effects: [On(Target, All([Damage(amount: 5), ApplyStatus(status: "avvinghiato")]))]), cooldown: 4, description: "Avvinghia la vittima: danni e non scappa.", tags: ["violenza"]),
        (id: "nube_d_inchiostro", name: "Nube d'inchiostro", weight: 3.0, kind: Effects(effects: [Stealth(amount: 60, duration: 3), ResetAggro, On(Radius(3), ApplyStatus(status: "imbrattato"))]),
         considerations: [(input: Condition(HpBelow(0.5)), curve: Identity)], cooldown: 24, description: "Sparisce nel nero e chi è vicino resta imbrattato.", tags: ["fuga"]),
    ],
    templates: [
        (id: "polipo", name: "Polipo dello Scantinato", race: "polipo", classes: ["bestia"], faction: "fauna_selvatica", slots: 0,
         actions: ["avvinghia_donna", "avvinghia_chiunque", "nube_d_inchiostro"]),
    ],
    buildings: [
        (id: "baule_nerd", name: "Baule dei tesori nerd", footprint: (1, 1), hp: 150, tags: ["cassaforte", "nerd"],
         description: "Fumetti introvabili, una spada laser vera e un anello che nessuno dovrebbe toccare. Lo sorveglia il polipo.",
         stock: {"spada_laser": 1, "anello_potere": 1, "costume_cosplay": 2, "boomerang": 1}),
    ],
    events: [
