// Lo Scantinato della Fumetteria, il dungeon dei nerd (botola nel Quartiere Nerd), e il suo abitante: il Polipo.
// Il polipo resta nello scantinato e attacca chi entra, ma punta soprattutto le donne: le avvinghia con i
// tentacoli e quando è in pericolo sparisce in una nube d'inchiostro.
(
    body_plans: [
        (id: "cefalopode", parts: [
            (id: "mantello", name: "Mantello", hp: 35, vital: true, coverage: 3, capacities: {"coscienza": 1, "vista": 1}),
            (id: "tentacolo_1", name: "Tentacolo 1", parent: "mantello", hp: 8, coverage: 0.5, capacities: {"manipulation": 0.125, "moving": 0.125}),
            (id: "tentacolo_2", name: "Tentacolo 2", parent: "mantello", hp: 8, coverage: 0.5, capacities: {"manipulation": 0.125, "moving": 0.125}),
