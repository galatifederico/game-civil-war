            (id: "tentacolo_5", name: "Tentacolo 5", parent: "mantello", hp: 8, coverage: 0.5, capacities: {"manipulation": 0.125, "moving": 0.125}),
            (id: "tentacolo_6", name: "Tentacolo 6", parent: "mantello", hp: 8, coverage: 0.5, capacities: {"manipulation": 0.125, "moving": 0.125}),
